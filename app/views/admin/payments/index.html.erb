<%= render "admin/shared/sidebar" %>
<% content_for :page_title, "Pembayaran" %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="text-lg font-bold">Riwayat Pembayaran Online</h2>
    <p class="mt-1 text-sm text-ink-500">Daftar percobaan dan konfirmasi pembayaran gateway. Tidak mencakup pembayaran di tempat.</p>
  </div>
  <%= form_with url: admin_payments_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
    <div>
      <%= label_tag :month, "Periode", class: "label" %>
      <%= month_field_tag :month, @month.strftime("%Y-%m"), class: "input" %>
    </div>
    <div>
      <%= label_tag :status, "Status", class: "label" %>
      <%= select_tag :status, options_for_select([["Semua status", ""]] + PaymentAttempt::STATUSES.map { |status| [status.humanize, status] }, @status), class: "input" %>
    </div>
    <div>
      <%= label_tag :q, "Cari", class: "label" %>
      <%= text_field_tag :q, params[:q], placeholder: "Order, booking, pelanggan, bisnis…", class: "input w-64" %>
    </div>
    <%= submit_tag "Terapkan", class: "btn-secondary btn-md" %>
  <% end %>
</div>

<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3">Order</th>
        <th class="px-4 py-3">Booking</th>
        <th class="px-4 py-3">Pelanggan / bisnis</th>
        <th class="px-4 py-3">Nominal</th>
        <th class="px-4 py-3">Metode</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3">Dikonfirmasi</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @payments.each do |payment| %>
        <% booking = payment.booking %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-mono text-xs"><%= payment.order_id %></td>
          <td class="px-4 py-3"><%= link_to booking.reference, admin_booking_path(booking), class: "font-mono text-xs text-primary-600 hover:underline" %></td>
          <td class="px-4 py-3"><span class="block font-medium"><%= booking.user.full_name %></span><span class="text-xs text-ink-500"><%= booking.business.name %></span></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(payment.amount) %></td>
          <td class="px-4 py-3"><%= payment.payment_type&.humanize || "—" %></td>
          <td class="px-4 py-3"><span class="badge <%= payment.status_badge_class %>"><%= payment.status.humanize %></span><%= " · #{payment.provider_status}" if payment.provider_status.present? && payment.provider_status != payment.status %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= payment.settled_at ? format_datetime_id(payment.settled_at) : "Belum dikonfirmasi" %></td>
        </tr>
      <% end %>
      <% if @payments.empty? %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-ink-500">Tidak ada pembayaran pada periode dan filter ini.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination" %>
