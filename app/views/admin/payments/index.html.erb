<%= render "admin/shared/sidebar" %>
<% content_for :page_title, t("admin.payments.title") %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="text-lg font-bold"><%= t("admin.payments.history") %></h2>
    <p class="mt-1 text-sm text-ink-500"><%= t("admin.payments.description") %></p>
  </div>
  <%= form_with url: admin_payments_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
    <div>
      <%= label_tag :month, t("admin.payments.period"), class: "label" %>
      <%= month_field_tag :month, @month.strftime("%Y-%m"), class: "input" %>
    </div>
    <div>
      <%= label_tag :status, t("admin.payments.status"), class: "label" %>
      <%= select_tag :status, options_for_select([[t("admin.payments.all_statuses"), ""]] + PaymentAttempt::STATUSES.map { |status| [t("booking.payment_statuses.#{status}", default: status.humanize), status] }, @status), class: "input" %>
    </div>
    <div>
      <%= label_tag :q, t("admin.payments.search"), class: "label" %>
      <%= text_field_tag :q, params[:q], placeholder: t("admin.payments.search_placeholder"), class: "input w-64" %>
    </div>
    <%= submit_tag t("admin.payments.apply"), class: "btn-secondary btn-md" %>
    <%= link_to t("admin.payments.download_csv"), admin_payments_path(month: @month.strftime("%Y-%m"), status: @status, q: params[:q], format: :csv), class: "btn-primary btn-md" %>
  <% end %>
</div>

<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("admin.payments.order") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.booking") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.customer_business") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.amount") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.method") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.status") %></th>
        <th class="px-4 py-3"><%= t("admin.payments.confirmed_at") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @payments.each do |payment| %>
        <% booking = payment.booking %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-mono text-xs"><%= payment.order_id %></td>
          <td class="px-4 py-3"><%= link_to booking.reference, admin_booking_path(booking), class: "font-mono text-xs text-primary-600 hover:underline" %></td>
          <td class="px-4 py-3"><span class="block font-medium"><%= booking.user.full_name %></span><span class="text-xs text-ink-500"><%= booking.business.name %></span></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(payment.amount) %></td>
          <td class="px-4 py-3"><%= payment.payment_type ? t("admin.payments.methods.#{payment.payment_type}", default: payment.payment_type.humanize) : "—" %><span class="mt-1 block text-xs text-ink-500"><%= payment.gateway_label %></span></td>
          <td class="px-4 py-3"><span class="badge <%= payment.status_badge_class %>"><%= t("booking.payment_statuses.#{payment.status}", default: payment.status.humanize) %></span><%= " · #{payment.provider_status}" if payment.provider_status.present? && payment.provider_status != payment.status %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= payment.settled_at ? format_datetime_id(payment.settled_at) : t("admin.payments.not_confirmed") %></td>
        </tr>
      <% end %>
      <% if @payments.empty? %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-ink-500"><%= t("admin.payments.empty") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination" %>
