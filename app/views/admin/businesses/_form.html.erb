<div class="card p-6 max-w-3xl">
  <%= form_with model: @business, url: @business.persisted? ? admin_business_path(@business.id) : admin_businesses_path, class: "space-y-5" do |f| %>
    <%= render "shared/form_errors", record: @business %>
    <div><%= f.label :name, t("admin.businesses.business"), class: "label" %><%= f.text_field :name, required: true, maxlength: 150, class: "input" %></div>
    <% if @business.new_record? %>
      <div><%= f.label :owner_id, t("admin.businesses.owner"), class: "label" %><%= f.collection_select :owner_id, User.where(role: [:customer, :business_owner]).where.not(id: Business.select(:owner_id)).order(:name), :id, :email, {include_blank: true}, required: true, class: "input" %></div>
    <% else %>
      <p class="text-sm text-ink-500"><%= t("admin.businesses.owner") %>: <%= @business.owner.email %></p>
    <% end %>
    <div><%= f.label :city_id, t("admin.businesses.city"), class: "label" %><%= f.collection_select :city_id, City.order(:name), :id, :name, {include_blank: true}, required: true, class: "input" %></div>
    <div><%= f.label :address, t("admin.management.address"), class: "label" %><%= f.text_area :address, required: true, class: "input", rows: 2 %></div>
    <div><%= f.label :phone, t("admin.user_management.phone"), class: "label" %><%= f.telephone_field :phone, required: true, class: "input" %></div>
    <div><%= f.label :description, t("admin.management.description"), class: "label" %><%= f.text_area :description, rows: 4, class: "input" %></div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div><%= f.label :latitude, t("admin.management.latitude"), class: "label" %><%= f.number_field :latitude, step: :any, min: -90, max: 90, class: "input" %></div>
      <div><%= f.label :longitude, t("admin.management.longitude"), class: "label" %><%= f.number_field :longitude, step: :any, min: -180, max: 180, class: "input" %></div>
    </div>
    <fieldset><legend class="label"><%= t("admin.categories.title") %></legend><%= f.collection_check_boxes :category_ids, Category.order(:name), :id, :name do |box| %><label class="inline-flex gap-2 mr-4 mb-2"><%= box.check_box %><%= box.text %></label><% end %></fieldset>
    <p class="text-sm text-ink-500"><%= t("admin.management.business_help") %></p>
    <div class="flex gap-3"><%= f.submit t("admin.management.save"), class: "btn-primary btn-md" %><%= link_to t("admin.management.back"), admin_businesses_path, class: "btn-secondary btn-md" %></div>
  <% end %>
</div>
