<%= render "admin/shared/sidebar" %>
<% content_for :page_title, @business.name %>

<div class="card p-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-xl font-extrabold"><%= @business.name %></h2>
      <p class="text-sm text-ink-500"><%= @business.address %>, <%= @business.city.name %></p>
      <p class="text-sm text-ink-500"><%= t("admin.businesses.owner_label") %> <%= @business.owner.full_name %> · 📞 <%= @business.phone %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to t("admin.management.edit"), edit_admin_business_path(@business.id), class: "btn-secondary btn-sm" %>
      <span class="badge <%= @business.active? ? 'badge-green' : (@business.pending? ? 'badge-amber' : 'badge-red') %>"><%= t("admin.businesses.#{@business.status}", default: @business.status.humanize) %></span>
      <% if @business.pending? %>
        <%= button_to t("admin.businesses.approve"), activate_admin_business_path(@business.id), method: :patch,
                      form: { data: { turbo_confirm: t("admin.businesses.approve_confirm", name: @business.name) } },
                      class: "btn-primary btn-sm" %>
      <% elsif @business.suspended? %>
        <%= button_to t("admin.businesses.reactivate"), reactivate_admin_business_path(@business.id), method: :patch,
                      form: { data: { turbo_confirm: t("admin.businesses.reactivate_confirm", name: @business.name) } },
                      class: "btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <section>
    <h3 class="text-lg font-extrabold"><%= t("admin.businesses.services") %> (<%= @services.size %>)</h3>
    <div class="card mt-3 divide-y divide-gray-50">
      <% @services.each do |s| %>
        <div class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span><%= s.name %> <span class="text-ink-400">· <%= t("admin.businesses.duration_minutes", count: s.duration_minutes) %></span></span>
          <span class="font-semibold"><%= format_idr(s.price) %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <h3 class="text-lg font-extrabold"><%= t("dashboard.nav.staff") %> (<%= @staff.size %>)</h3>
    <div class="card mt-3 divide-y divide-gray-50">
      <% @staff.each do |s| %>
        <div class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span><%= s.name %> <span class="text-ink-400">· <%= s.display_title %></span></span>
          <span class="badge <%= s.active? ? 'badge-green' : 'badge-gray' %>"><%= t("admin.businesses.staff_status.#{s.active? ? 'active' : 'inactive'}") %></span>
        </div>
      <% end %>
    </div>
  </section>
</div>

<h3 class="mt-6 text-lg font-extrabold"><%= t("admin.businesses.recent_bookings") %></h3>
<div class="card mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("admin.businesses.code") %></th><th class="px-4 py-3"><%= t("admin.businesses.customer") %></th><th class="px-4 py-3"><%= t("admin.businesses.time") %></th><th class="px-4 py-3"><%= t("admin.businesses.total") %></th><th class="px-4 py-3"><%= t("admin.businesses.booking_status") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @bookings.each do |b| %>
        <tr>
          <td class="px-4 py-3 font-mono text-xs"><%= b.reference %></td>
          <td class="px-4 py-3"><%= b.user.full_name %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= l(b.start_time, format: "%d %b %Y, %H:%M") %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(b.total_amount) %></td>
          <td class="px-4 py-3"><span class="badge <%= b.status_badge_class %>"><%= t("booking.status.#{b.status}", default: b.status.humanize) %></span></td>
        </tr>
      <% end %>
      <% if @bookings.empty? %><tr><td colspan="5" class="px-4 py-8 text-center text-ink-500"><%= t("admin.businesses.no_bookings") %></td></tr><% end %>
    </tbody>
  </table>
</div>

<h3 class="mt-6 text-lg font-extrabold"><%= t("admin.businesses.latest_reviews") %></h3>
<div class="mt-3 space-y-3">
  <% @reviews.each do |r| %>
    <div class="card p-4">
      <p class="text-sm font-semibold"><%= r.user.full_name %> <span class="text-amber-500"><%= r.stars %></span></p>
      <p class="mt-1 text-sm text-ink-600"><%= r.comment %></p>
    </div>
  <% end %>
  <% if @reviews.empty? %><p class="text-sm text-ink-500"><%= t("admin.businesses.no_reviews") %></p><% end %>
</div>
