<%= render "admin/shared/sidebar" %>
<% content_for :page_title, @business.name %>

<div class="card p-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-xl font-extrabold"><%= @business.name %></h2>
      <p class="text-sm text-ink-500"><%= @business.address %>, <%= @business.city.name %></p>
      <p class="text-sm text-ink-500">Pemilik: <%= @business.owner.full_name %> · 📞 <%= @business.phone %></p>
    </div>
    <div class="flex items-center gap-3">
      <span class="badge <%= @business.active? ? 'badge-green' : (@business.pending? ? 'badge-amber' : 'badge-red') %>"><%= @business.status.humanize %></span>
      <% if @business.pending? %>
        <%= button_to "Setujui & Aktifkan", activate_admin_business_path(@business), method: :patch,
                      form: { data: { turbo_confirm: "Publikasikan #{@business.name} di marketplace?" } },
                      class: "btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <section>
    <h3 class="text-lg font-extrabold">Layanan (<%= @services.size %>)</h3>
    <div class="card mt-3 divide-y divide-gray-50">
      <% @services.each do |s| %>
        <div class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span><%= s.name %> <span class="text-ink-400">· <%= s.duration_minutes %> mnt</span></span>
          <span class="font-semibold"><%= format_idr(s.price) %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <h3 class="text-lg font-extrabold">Staff (<%= @staff.size %>)</h3>
    <div class="card mt-3 divide-y divide-gray-50">
      <% @staff.each do |s| %>
        <div class="flex items-center justify-between px-4 py-2.5 text-sm">
          <span><%= s.name %> <span class="text-ink-400">· <%= s.display_title %></span></span>
          <span class="badge <%= s.active? ? 'badge-green' : 'badge-gray' %>"><%= s.active? ? "Aktif" : "Nonaktif" %></span>
        </div>
      <% end %>
    </div>
  </section>
</div>

<h3 class="mt-6 text-lg font-extrabold">Booking Terakhir</h3>
<div class="card mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3">Kode</th><th class="px-4 py-3">Pelanggan</th><th class="px-4 py-3">Waktu</th><th class="px-4 py-3">Total</th><th class="px-4 py-3">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @bookings.each do |b| %>
        <tr>
          <td class="px-4 py-3 font-mono text-xs"><%= b.reference %></td>
          <td class="px-4 py-3"><%= b.user.full_name %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= b.start_time.strftime("%d %b %Y, %H:%M") %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(b.total_amount) %></td>
          <td class="px-4 py-3"><span class="badge <%= b.status_badge_class %>"><%= b.status.humanize %></span></td>
        </tr>
      <% end %>
      <% if @bookings.empty? %><tr><td colspan="5" class="px-4 py-8 text-center text-ink-500">Belum ada booking.</td></tr><% end %>
    </tbody>
  </table>
</div>

<h3 class="mt-6 text-lg font-extrabold">Ulasan Terbaru</h3>
<div class="mt-3 space-y-3">
  <% @reviews.each do |r| %>
    <div class="card p-4">
      <p class="text-sm font-semibold"><%= r.user.full_name %> <span class="text-amber-500"><%= r.stars %></span></p>
      <p class="mt-1 text-sm text-ink-600"><%= r.comment %></p>
    </div>
  <% end %>
  <% if @reviews.empty? %><p class="text-sm text-ink-500">Belum ada ulasan.</p><% end %>
</div>
