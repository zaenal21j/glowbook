<%= render "admin/shared/sidebar" %>
<% content_for :page_title, "Bisnis" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2 overflow-x-auto">
    <%= link_to "Semua (#{@counts[:all]})", admin_businesses_path, class: "chip #{'chip-active' if params[:status].blank?}" %>
    <%= link_to "Aktif (#{@counts[:active]})", admin_businesses_path(status: "active"), class: "chip #{'chip-active' if params[:status] == 'active'}" %>
    <%= link_to "Menunggu (#{@counts[:pending]})", admin_businesses_path(status: "pending"), class: "chip #{'chip-active' if params[:status] == 'pending'}" %>
    <%= link_to "Ditangguhkan (#{@counts[:suspended]})", admin_businesses_path(status: "suspended"), class: "chip #{'chip-active' if params[:status] == 'suspended'}" %>
  </div>
  <%= form_with url: admin_businesses_path, method: :get, class: "flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Cari bisnis…", class: "input w-56" %>
    <%= hidden_field_tag :status, params[:status] %>
    <button class="btn-secondary btn-md">Cari</button>
  <% end %>
</div>

<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3">Bisnis</th>
        <th class="px-4 py-3">Kota</th>
        <th class="px-4 py-3">Pemilik</th>
        <th class="px-4 py-3">Rating</th>
        <th class="px-4 py-3">Layanan</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @businesses.each do |b| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-medium"><%= link_to b.name, admin_business_path(b), class: "hover:text-primary-600" %></td>
          <td class="px-4 py-3"><%= b.city.name %></td>
          <td class="px-4 py-3"><%= b.owner.full_name %></td>
          <td class="px-4 py-3"><%= b.rating_label %></td>
          <td class="px-4 py-3"><%= b.services.count %></td>
          <td class="px-4 py-3"><span class="badge <%= b.active? ? 'badge-green' : (b.pending? ? 'badge-amber' : 'badge-red') %>"><%= b.status.humanize %></span></td>
          <td class="px-4 py-3 text-right">
            <% unless b.suspended? %>
              <%= button_to "Tangguhkan", admin_business_path(b), method: :delete, form: { data: { turbo_confirm: "Tangguhkan #{b.name}?" } }, class: "text-xs font-semibold text-red-500 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @businesses.empty? %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-ink-500">Tidak ada bisnis.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
