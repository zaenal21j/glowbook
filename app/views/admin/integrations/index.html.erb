<% content_for :title, t("integrations.title") %>
<% content_for :page_title, t("integrations.title") %>
<%= render "admin/shared/sidebar" %>

<div class="mb-8">
  <h1 class="text-2xl font-extrabold"><%= t("integrations.title") %></h1>
  <p class="mt-2 max-w-3xl text-sm text-ink-500"><%= t("integrations.description") %></p>
</div>

<div class="space-y-6">
  <% @integrations.each do |provider, integration| %>
    <% values = integration.settings %>
    <section class="card p-6" aria-labelledby="<%= provider %>_heading">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <h2 id="<%= provider %>_heading" class="text-lg font-bold"><%= t("integrations.providers.#{provider}") %></h2>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold"><%= integration.enabled? && integration.errors.empty? ? t("integrations.enabled") : t("integrations.disabled") %></span>
      </div>
      <% if integration.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-700" role="alert">
          <ul class="list-inside list-disc"><% integration.errors.full_messages.each do |error| %><li><%= error %></li><% end %></ul>
        </div>
      <% end %>
      <%= form_with scope: :integration_setting, url: admin_integration_path(provider: provider), method: :patch, class: "space-y-4" do |form| %>
        <label class="flex items-center gap-2 text-sm font-semibold" for="<%= provider %>_enabled">
          <%= form.check_box :enabled, { checked: integration.enabled?, id: "#{provider}_enabled", class: "h-4 w-4 rounded border-gray-300" }, "1", "0" %>
          <%= t("integrations.enable") %>
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= form.fields_for :settings do |fields| %>
            <% IntegrationSetting::FIELDS.fetch(provider).each do |field| %>
              <div>
                <%= fields.label field, t("integrations.fields.#{field}"), for: "#{provider}_#{field}", class: "label" %>
                <% if IntegrationSetting::SECRET_FIELDS.include?(field) %>
                  <%= fields.password_field field, value: nil, id: "#{provider}_#{field}", autocomplete: "new-password", class: "input" %>
                  <p class="mt-1 text-xs text-ink-500"><%= integration.errors.any? ? t("integrations.secret_retry") : (values[field].present? ? t("integrations.secret_saved") : t("integrations.secret_empty")) %></p>
                <% elsif field == "environment" %>
                  <%= fields.select field, [[t("duitku.sandbox"), "sandbox"], [t("duitku.production"), "production"]], { selected: values[field] }, id: "#{provider}_#{field}", class: "input" %>
                <% elsif field == "tls_mode" %>
                  <%= fields.select field, [[t("integrations.starttls"), "starttls"], [t("integrations.tls"), "tls"]], { selected: values[field] }, id: "#{provider}_#{field}", class: "input" %>
                <% elsif field == "expiry_minutes" %>
                  <%= fields.number_field field, value: values[field], min: 1, max: 1440, id: "#{provider}_#{field}", class: "input" %>
                <% elsif field == "port" %>
                  <%= fields.number_field field, value: values[field], min: 1, max: 65535, id: "#{provider}_#{field}", class: "input" %>
                <% else %>
                  <%= fields.text_field field, value: values[field], id: "#{provider}_#{field}", autocomplete: "off", class: "input" %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <% if IntegrationSetting::SECRET_FIELDS.any? { |field| values[field].present? } %>
          <label class="flex items-center gap-2 text-xs text-ink-500" for="<%= provider %>_clear_secret">
            <%= form.check_box :clear_secret, id: "#{provider}_clear_secret", class: "h-4 w-4 rounded border-gray-300" %>
            <%= t("integrations.clear_secret") %>
          </label>
        <% end %>
        <% if provider == "duitku" %>
          <div class="rounded-lg bg-gray-50 p-3 text-sm">
            <p class="font-semibold"><%= t("duitku.callback_label") %></p>
            <code class="mt-1 block break-all"><%= "#{Rails.configuration.x.app_host.chomp('/')}#{duitku_callback_path}" %></code>
            <p class="mt-2 text-xs text-ink-500"><%= t("duitku.configuration_help") %></p>
          </div>
        <% elsif provider != "smtp" %>
          <div class="rounded-lg bg-gray-50 p-3 text-sm">
            <p class="font-semibold"><%= t("integrations.callback_label") %></p>
            <code class="mt-1 block break-all"><%= "#{Rails.configuration.x.app_host.chomp('/')}/users/auth/#{provider}/callback" %></code>
            <p class="mt-2 text-xs text-ink-500"><%= t("integrations.oauth_help") %></p>
          </div>
        <% else %>
          <p class="text-xs text-ink-500"><%= t("integrations.smtp_help") %></p>
        <% end %>
        <%= form.submit t("integrations.save"), class: "btn-primary btn-md" %>
      <% end %>
    </section>
  <% end %>
</div>
<p class="mt-6 max-w-3xl text-sm text-ink-500"><%= t("integrations.server_help") %></p>
