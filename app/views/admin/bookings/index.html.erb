<%= render "admin/shared/sidebar" %>
<% content_for :page_title, t("admin.bookings.title") %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2 overflow-x-auto">
    <%= link_to "#{t('admin.bookings.all')} (#{@counts[:all]})", admin_bookings_path(q: params[:q]), class: "chip #{'chip-active' if params[:status].blank?}" %>
    <%= link_to "#{t('admin.bookings.pending')} (#{@counts[:pending]})", admin_bookings_path(status: "pending", q: params[:q]), class: "chip #{'chip-active' if params[:status] == 'pending'}" %>
    <%= link_to "#{t('admin.bookings.confirmed')} (#{@counts[:confirmed]})", admin_bookings_path(status: "confirmed", q: params[:q]), class: "chip #{'chip-active' if params[:status] == 'confirmed'}" %>
    <%= link_to "#{t('admin.bookings.completed')} (#{@counts[:completed]})", admin_bookings_path(status: "completed", q: params[:q]), class: "chip #{'chip-active' if params[:status] == 'completed'}" %>
    <%= link_to "#{t('admin.bookings.cancelled')} (#{@counts[:cancelled]})", admin_bookings_path(status: "cancelled", q: params[:q]), class: "chip #{'chip-active' if params[:status] == 'cancelled'}" %>
    <%= link_to "#{t('admin.bookings.no_show')} (#{@counts[:no_show]})", admin_bookings_path(status: "no_show", q: params[:q]), class: "chip #{'chip-active' if params[:status] == 'no_show'}" %>
  </div>
</div>
<div class="card mt-5 overflow-x-auto">
  <%= render "shared/table_controls", key: "bookings" %>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("admin.bookings.code") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.customer") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.business") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.service") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.time") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.total") %></th>
        <th class="px-4 py-3"><%= t("admin.bookings.status") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @bookings.each do |b| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-mono text-xs"><%= link_to b.reference, admin_booking_path(b), class: "text-primary-600 hover:underline" %></td>
          <td class="px-4 py-3 font-medium"><%= b.user.full_name %></td>
          <td class="px-4 py-3"><%= b.business.name %></td>
          <td class="px-4 py-3"><%= b.booking_items.map(&:label).join(", ") %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= l(b.start_time, format: "%d %b %Y, %H:%M") %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(b.total_amount) %></td>
          <td class="px-4 py-3"><span class="badge <%= b.status_badge_class %>"><%= t("booking.status.#{b.status}", default: b.status.humanize) %></span></td>
        </tr>
      <% end %>
      <% if @bookings.empty? %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-ink-500"><%= t("admin.bookings.no_bookings") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/table_pagination", key: "bookings" %>
