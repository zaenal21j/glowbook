<%= render "admin/shared/sidebar" %>
<% content_for :page_title, t("admin.users.title") %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <%= link_to t("admin.user_management.add"), new_admin_user_path, class: "btn-primary btn-md" %>
  <div class="flex gap-2 overflow-x-auto">
    <%= link_to "#{t('admin.users.all')} (#{@counts[:all]})", admin_users_path, class: "chip #{'chip-active' if params[:role].blank?}" %>
    <%= link_to "#{t('admin.users.customers')} (#{@counts[:customer]})", admin_users_path(role: "customer"), class: "chip #{'chip-active' if params[:role] == 'customer'}" %>
    <%= link_to "#{t('admin.users.business_owners')} (#{@counts[:owner]})", admin_users_path(role: "owner"), class: "chip #{'chip-active' if params[:role] == 'owner'}" %>
    <%= link_to "#{t('admin.users.admins')} (#{@counts[:admin]})", admin_users_path(role: "admin"), class: "chip #{'chip-active' if params[:role] == 'admin'}" %>
  </div>
  <%= form_with url: admin_users_path, method: :get, class: "flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: t("admin.users.search_placeholder"), class: "input w-56" %>
    <%= hidden_field_tag :role, params[:role] %>
    <button class="btn-secondary btn-md"><%= t("admin.users.search") %></button>
  <% end %>
</div>
<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("admin.users.name") %></th>
        <th class="px-4 py-3"><%= t("admin.users.email") %></th>
        <th class="px-4 py-3"><%= t("admin.users.role") %></th>
        <th class="px-4 py-3"><%= t("admin.users.bookings") %></th>
        <th class="px-4 py-3"><%= t("admin.users.registered") %></th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @users.each do |u| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-medium"><%= link_to u.full_name, admin_user_path(u), class: "hover:text-primary-600" %></td>
          <td class="px-4 py-3"><%= u.email %></td>
          <td class="px-4 py-3"><span class="badge <%= u.admin? ? 'badge-amber' : 'badge-gray' %>"><%= t("admin.users.roles.#{u.role}", default: u.role.humanize) %></span></td>
          <td class="px-4 py-3"><%= u.bookings.count %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= l(u.created_at, format: "%d %b %Y") %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to t("admin.user_management.edit"), edit_admin_user_path(u), class: "text-xs font-semibold text-primary-600 hover:underline mr-3" %>
            <% unless u == current_user || u.admin? || u.has_retained_records? %>
              <%= button_to t("admin.users.delete"), admin_user_path(u), method: :delete, form: { data: { turbo_confirm: t("admin.users.delete_confirm", name: u.full_name) } }, class: "text-xs font-semibold text-red-500 hover:underline" %>
            <% end %>
            <% if u == current_user || u.admin? || u.has_retained_records? %>
              <span class="text-xs text-ink-500" title="<%= t('admin.user_management.retained_help') %>"><%= t("admin.user_management.protected") %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr><td colspan="6" class="px-4 py-10 text-center text-ink-500"><%= t("admin.users.no_users") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination" %>
