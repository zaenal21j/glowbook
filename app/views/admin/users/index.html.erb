<%= render "admin/shared/sidebar" %>
<% content_for :page_title, "Pengguna" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-2 overflow-x-auto">
    <%= link_to "Semua (#{@counts[:all]})", admin_users_path, class: "chip #{'chip-active' if params[:role].blank?}" %>
    <%= link_to "Pelanggan (#{@counts[:customer]})", admin_users_path(role: "customer"), class: "chip #{'chip-active' if params[:role] == 'customer'}" %>
    <%= link_to "Pemilik Bisnis (#{@counts[:owner]})", admin_users_path(role: "owner"), class: "chip #{'chip-active' if params[:role] == 'owner'}" %>
    <%= link_to "Admin (#{@counts[:admin]})", admin_users_path(role: "admin"), class: "chip #{'chip-active' if params[:role] == 'admin'}" %>
  </div>
  <%= form_with url: admin_users_path, method: :get, class: "flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Cari nama/email…", class: "input w-56" %>
    <%= hidden_field_tag :role, params[:role] %>
    <button class="btn-secondary btn-md">Cari</button>
  <% end %>
</div>
<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3">Nama</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Peran</th>
        <th class="px-4 py-3">Booking</th>
        <th class="px-4 py-3">Terdaftar</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @users.each do |u| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-medium"><%= link_to u.full_name, admin_user_path(u), class: "hover:text-primary-600" %></td>
          <td class="px-4 py-3"><%= u.email %></td>
          <td class="px-4 py-3"><span class="badge <%= u.admin? ? 'badge-amber' : 'badge-gray' %>"><%= u.role.humanize %></span></td>
          <td class="px-4 py-3"><%= u.bookings.count %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= u.created_at.strftime("%d %b %Y") %></td>
          <td class="px-4 py-3 text-right">
            <% unless u == current_user %>
              <%= button_to "Hapus", admin_user_path(u), method: :delete, form: { data: { turbo_confirm: "Hapus #{u.full_name}?" } }, class: "text-xs font-semibold text-red-500 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr><td colspan="6" class="px-4 py-10 text-center text-ink-500">Tidak ada pengguna.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "admin/shared/pagination" %>
