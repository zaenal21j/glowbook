<%= render "admin/shared/sidebar" %>
<% content_for :page_title, @user.full_name %>

<div class="card p-6">
  <div class="flex gap-3 mb-4">
    <%= link_to t("admin.user_management.back"), admin_users_path, class: "btn-secondary btn-sm" %>
    <%= link_to t("admin.user_management.edit"), edit_admin_user_path(@user), class: "btn-primary btn-sm" %>
  </div>
  <div class="flex items-center gap-4">
    <%= avatar_placeholder(@user.full_name, size: 14) %>
    <div>
      <h2 class="text-xl font-extrabold"><%= @user.full_name %></h2>
      <p class="text-sm text-ink-500"><%= @user.email %> · <%= t("admin.users.roles.#{@user.role}", default: @user.role.humanize) %></p>
      <% if @user.phone.present? %><p class="text-sm text-ink-500">📞 <%= @user.phone %></p><% end %>
    </div>
  </div>
</div>

<h2 class="mt-6 text-lg font-extrabold"><%= t("admin.users.booking_history") %></h2>
<div class="card mt-4 overflow-x-auto">
  <%= render "shared/table_controls", key: "bookings" %>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("admin.users.code") %></th>
        <th class="px-4 py-3"><%= t("admin.users.business") %></th>
        <th class="px-4 py-3"><%= t("admin.users.service") %></th>
        <th class="px-4 py-3"><%= t("admin.users.time") %></th>
        <th class="px-4 py-3"><%= t("admin.users.total") %></th>
        <th class="px-4 py-3"><%= t("admin.users.status") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @bookings.each do |b| %>
        <tr>
          <td class="px-4 py-3 font-mono text-xs"><%= b.reference %></td>
          <td class="px-4 py-3"><%= b.business.name %></td>
          <td class="px-4 py-3"><%= b.booking_items.map(&:label).join(", ") %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= l(b.start_time, format: "%d %b %Y, %H:%M") %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(b.total_amount) %></td>
          <td class="px-4 py-3"><span class="badge <%= b.status_badge_class %>"><%= t("booking.status.#{b.status}", default: b.status.humanize) %></span></td>
        </tr>
      <% end %>
      <% if @bookings.empty? %>
        <tr><td colspan="6" class="px-4 py-10 text-center text-ink-500"><%= t("admin.users.no_bookings") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_pagination", key: "bookings" %>
