<%= form_with model: category, url: url, class: "space-y-3" do |f| %>
  <%= render "shared/form_errors", record: category %>
  <div>
    <%= f.label :name, t("admin.categories.name"), class: "label" %>
    <%= f.text_field :name, class: "input", required: true %>
  </div>
  <div>
    <%= f.label :slug, "Slug", class: "label" %>
    <%= f.text_field :slug, class: "input font-mono text-sm" %>
  </div>
  <div>
    <%= f.label :tagline, t("admin.categories.tagline"), class: "label" %>
    <%= f.text_field :tagline, class: "input" %>
  </div>
  <div>
    <%= f.label :position, t("admin.categories.position"), class: "label" %>
    <%= f.number_field :position, class: "input" %>
  </div>
  <div class="flex gap-2 pt-2">
    <button class="btn-primary btn-md flex-1"><%= t("admin.categories.save") %></button>
    <%= link_to t("admin.categories.cancel"), admin_categories_path, class: "btn-ghost btn-md" %>
  </div>
<% end %>
