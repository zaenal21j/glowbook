<%= render "dashboard/shared/sidebar" %>
<% content_for :page_title, t("dashboard.bookings_page.title") %>

<div class="flex gap-2 overflow-x-auto scrollbar-none">
  <%= link_to t("dashboard.bookings_page.upcoming"), dashboard_bookings_path, class: "chip #{'chip-active' if params[:status].blank?}" %>
  <%= link_to t("dashboard.bookings_page.pending"), dashboard_bookings_path(status: "pending"), class: "chip #{'chip-active' if params[:status] == 'pending'}" %>
  <%= link_to t("dashboard.bookings_page.confirmed"), dashboard_bookings_path(status: "confirmed"), class: "chip #{'chip-active' if params[:status] == 'confirmed'}" %>
  <%= link_to t("dashboard.bookings_page.completed"), dashboard_bookings_path(status: "completed"), class: "chip #{'chip-active' if params[:status] == 'completed'}" %>
  <%= link_to t("dashboard.bookings_page.cancelled"), dashboard_bookings_path(status: "cancelled"), class: "chip #{'chip-active' if params[:status] == 'cancelled'}" %>
  <%= link_to t("dashboard.bookings_page.no_show"), dashboard_bookings_path(status: "no_show"), class: "chip #{'chip-active' if params[:status] == 'no_show'}" %>
</div>

<div class="card mt-5 overflow-x-auto">
  <%= render "shared/table_controls", key: "bookings" %>
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.code") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.customer") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.service") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.staff") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.time") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.total") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.status") %></th>
        <th class="px-4 py-3"><%= t("dashboard.bookings_page.actions") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @bookings.each do |b| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-mono text-xs"><%= b.reference %></td>
          <td class="px-4 py-3 font-medium"><%= b.user.full_name %></td>
          <td class="px-4 py-3"><%= b.booking_items.map(&:label).join(", ") %></td>
          <td class="px-4 py-3"><%= b.booking_items.first&.staff&.name || "—" %></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= l(b.start_time, format: "%d %b %Y, %H:%M") %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(b.total_amount) %></td>
          <td class="px-4 py-3"><span class="badge <%= b.status_badge_class %>"><%= t("booking.status.#{b.status}", default: b.status.humanize) %></span></td>
          <td class="space-y-1 px-4 py-3">
            <% if b.cancellable? %>
              <%= button_to t("dashboard.bookings_page.cancel"), dashboard_booking_status_path(b), method: :patch,
                            params: { status: "cancelled", return_status: params[:status] },
                            form: { data: { turbo_confirm: t("dashboard.bookings_page.cancel_confirm", reference: b.reference) } },
                            class: "text-xs font-semibold text-red-600 hover:underline" %>
            <% end %>
            <% if b.completable? %>
              <%= button_to t("dashboard.bookings_page.mark_complete"), dashboard_booking_status_path(b), method: :patch,
                            params: { status: "completed", return_status: params[:status] },
                            class: "text-xs font-semibold text-emerald-700 hover:underline" %>
            <% end %>
            <% if b.no_showable? %>
              <%= button_to t("dashboard.bookings_page.mark_no_show"), dashboard_booking_status_path(b), method: :patch,
                            params: { status: "no_show", return_status: params[:status] },
                            form: { data: { turbo_confirm: t("dashboard.bookings_page.no_show_confirm") } },
                            class: "text-xs font-semibold text-amber-700 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @bookings.empty? %>
        <tr><td colspan="8" class="px-4 py-10 text-center text-ink-500"><%= t("dashboard.bookings_page.empty") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/table_pagination", key: "bookings" %>
