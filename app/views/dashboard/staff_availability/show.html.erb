<%= render "dashboard/shared/sidebar" %>
<% content_for :page_title, t("scheduling.title", name: @staff_member.name) %>

<div class="max-w-4xl space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-extrabold"><%= t("scheduling.title", name: @staff_member.name) %></h1>
      <p class="mt-1 text-sm text-ink-500"><%= t("scheduling.description") %></p>
    </div>
    <%= link_to t("scheduling.back_to_staff"), dashboard_staffs_path, class: "btn-secondary btn-sm" %>
  </div>

  <section class="card space-y-4 p-5">
    <h2 class="font-bold"><%= t("scheduling.shifts") %></h2>
    <% if @schedules.empty? %>
      <p class="text-sm text-ink-500"><%= t("scheduling.no_shifts") %></p>
      <%= button_to t("scheduling.copy_hours"), dashboard_copy_staff_hours_path(@staff_member), method: :post, class: "btn-secondary btn-sm" %>
    <% else %>
      <ul class="divide-y divide-line">
        <% @schedules.each do |shift| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
            <span><strong><%= t("date.day_names")[shift.weekday] %></strong> · <%= format_minute_of_day(shift.start_minute) %>–<%= format_minute_of_day(shift.end_minute) %></span>
            <div class="flex items-center gap-3">
              <%= link_to t("scheduling.edit"), dashboard_staff_availability_path(@staff_member, shift_id: shift.id), class: "font-semibold text-primary-600" %>
              <%= button_to t("scheduling.delete"), dashboard_staff_shift_path(@staff_member, shift), method: :delete, form: { data: { turbo_confirm: t("scheduling.delete_confirm") } }, class: "text-red-600" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
    <h3 class="border-t border-line pt-4 text-sm font-bold"><%= t(@schedule.persisted? ? "scheduling.edit_shift" : "scheduling.add_shift") %></h3>
    <%= form_with model: @schedule, url: @schedule.persisted? ? dashboard_staff_shift_path(@staff_member, @schedule) : dashboard_staff_shifts_path(@staff_member), class: "space-y-3" do |f| %>
      <%= render "shared/form_errors", record: @schedule %>
      <%= render "weekly_fields", f: f %>
      <div class="flex gap-2">
        <%= f.submit t("scheduling.save"), class: "btn-primary btn-sm" %>
        <% if @schedule.persisted? %><%= link_to t("scheduling.cancel"), dashboard_staff_availability_path(@staff_member), class: "btn-ghost btn-sm" %><% end %>
      </div>
    <% end %>
  </section>

  <section class="card space-y-4 p-5">
    <h2 class="font-bold"><%= t("scheduling.breaks") %></h2>
    <p class="text-sm text-ink-500"><%= t("scheduling.breaks_help") %></p>
    <% if @breaks.empty? %>
      <p class="text-sm text-ink-500"><%= t("scheduling.no_breaks") %></p>
    <% else %>
      <ul class="divide-y divide-line">
        <% @breaks.each do |staff_break| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm">
            <span><strong><%= t("date.day_names")[staff_break.weekday] %></strong> · <%= format_minute_of_day(staff_break.start_minute) %>–<%= format_minute_of_day(staff_break.end_minute) %></span>
            <div class="flex items-center gap-3">
              <%= link_to t("scheduling.edit"), dashboard_staff_availability_path(@staff_member, break_id: staff_break.id), class: "font-semibold text-primary-600" %>
              <%= button_to t("scheduling.delete"), dashboard_staff_break_path(@staff_member, staff_break), method: :delete, form: { data: { turbo_confirm: t("scheduling.delete_confirm") } }, class: "text-red-600" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
    <h3 class="border-t border-line pt-4 text-sm font-bold"><%= t(@staff_break.persisted? ? "scheduling.edit_break" : "scheduling.add_break") %></h3>
    <%= form_with model: @staff_break, url: @staff_break.persisted? ? dashboard_staff_break_path(@staff_member, @staff_break) : dashboard_staff_breaks_path(@staff_member), class: "space-y-3" do |f| %>
      <%= render "shared/form_errors", record: @staff_break %>
      <%= render "weekly_fields", f: f %>
      <div class="flex gap-2">
        <%= f.submit t("scheduling.save"), class: "btn-primary btn-sm" %>
        <% if @staff_break.persisted? %><%= link_to t("scheduling.cancel"), dashboard_staff_availability_path(@staff_member), class: "btn-ghost btn-sm" %><% end %>
      </div>
    <% end %>
  </section>
</div>
