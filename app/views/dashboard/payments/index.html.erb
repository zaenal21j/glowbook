<%= render "dashboard/shared/sidebar" %>
<% content_for :page_title, t("dashboard.finance.title") %>

<div class="flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="text-lg font-bold"><%= t("dashboard.finance.history") %></h2>
    <p class="mt-1 max-w-2xl text-sm text-ink-500"><%= t("dashboard.finance.description", business: @business.name) %></p>
  </div>
  <%= form_with url: dashboard_finance_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
    <div>
      <%= label_tag :month, t("dashboard.finance.period"), class: "label" %>
      <%= month_field_tag :month, @month.strftime("%Y-%m"), class: "input" %>
    </div>
    <div>
      <%= label_tag :status, t("dashboard.finance.status"), class: "label" %>
      <%= select_tag :status, options_for_select([[t("dashboard.finance.all_statuses"), ""]] + PaymentAttempt::STATUSES.map { |status| [t("booking.payment_statuses.#{status}", default: status.humanize), status] }, @status), class: "input" %>
    </div>
    <div>
      <%= label_tag :q, t("dashboard.finance.search"), class: "label" %>
      <%= text_field_tag :q, params[:q], placeholder: t("dashboard.finance.search_placeholder"), class: "input w-64" %>
    </div>
    <%= submit_tag t("dashboard.finance.apply"), class: "btn-secondary btn-md" %>
    <%= link_to t("dashboard.finance.download_csv"), dashboard_finance_path(month: @month.strftime("%Y-%m"), status: @status, q: params[:q], format: :csv), class: "btn-primary btn-md" %>
  <% end %>
</div>

<div class="card mt-5 max-w-sm p-5">
  <p class="text-sm text-ink-500"><%= t("dashboard.finance.confirmed_month") %></p>
  <p class="mt-1 text-2xl font-bold"><%= format_idr(@online_collected) %></p>
  <p class="mt-1 text-xs text-ink-400"><%= t("dashboard.finance.gross_note") %></p>
</div>

<div class="card mt-5 overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
        <th class="px-4 py-3"><%= t("dashboard.finance.order") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.booking") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.customer") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.amount") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.method") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.status") %></th>
        <th class="px-4 py-3"><%= t("dashboard.finance.confirmed_at") %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @payments.each do |payment| %>
        <tr class="hover:bg-gray-50/60">
          <td class="px-4 py-3 font-mono text-xs"><%= payment.order_id %></td>
          <td class="px-4 py-3 font-mono text-xs"><%= payment.booking.reference %></td>
          <td class="px-4 py-3"><%= payment.booking.user.full_name %></td>
          <td class="px-4 py-3 font-semibold"><%= format_idr(payment.amount) %></td>
          <td class="px-4 py-3"><%= payment.payment_type ? t("admin.payments.methods.#{payment.payment_type}", default: payment.payment_type.humanize) : "—" %><span class="mt-1 block text-xs text-ink-500"><%= payment.gateway_label %></span></td>
          <td class="px-4 py-3"><span class="badge <%= payment.status_badge_class %>"><%= t("booking.payment_statuses.#{payment.status}", default: payment.status.humanize) %></span></td>
          <td class="px-4 py-3 whitespace-nowrap"><%= payment.settled_at ? format_datetime_id(payment.settled_at) : t("dashboard.finance.not_confirmed") %></td>
        </tr>
      <% end %>
      <% if @payments.empty? %>
        <tr><td colspan="7" class="px-4 py-10 text-center text-ink-500"><%= t("dashboard.finance.empty") %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination" %>
