<%= form_with model: promotion, url: promotion.persisted? ? dashboard_manage_promotion_path(promotion) : dashboard_manage_promotions_path, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :title, "Judul promosi", class: "label" %>
    <%= f.text_field :title, class: "input", required: true, placeholder: "Contoh: Diskon Spesial Akhir Pekan" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :code, "Kode kupon (opsional)", class: "label" %>
      <%= f.text_field :code, class: "input font-mono uppercase", placeholder: "GLOW20" %>
    </div>
    <div>
      <%= f.label :discount_percent, "Diskon (%)", class: "label" %>
      <%= f.number_field :discount_percent, class: "input", min: 1, max: 90, required: true %>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :starts_at, "Mulai", class: "label" %>
      <%= f.datetime_local_field :starts_at, class: "input" %>
    </div>
    <div>
      <%= f.label :ends_at, "Berakhir", class: "label" %>
      <%= f.datetime_local_field :ends_at, class: "input" %>
    </div>
  </div>
  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :active, class: "h-4 w-4 rounded accent-primary-600" %>
    Aktifkan sekarang
  </label>
  <div class="flex gap-2 pt-2">
    <button class="btn-primary btn-md flex-1">Simpan</button>
    <%= link_to "Batal", dashboard_promotions_path, class: "btn-ghost btn-md" %>
  </div>
<% end %>
