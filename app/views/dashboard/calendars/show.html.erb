<%= render "dashboard/shared/sidebar" %>
<% content_for :page_title, "Kalender" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-1 rounded-full border border-gray-200 bg-white p-1">
    <% { "hari" => "Hari", "minggu" => "Minggu", "bulan" => "Bulan" }.each do |key, label| %>
      <%= link_to label, dashboard_calendar_path(view: key, date: @date), class: "rounded-full px-4 py-1.5 text-sm font-semibold #{'bg-primary-600 text-white' if @view == key} #{'text-ink-500 hover:text-ink-900' if @view != key}" %>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <%= link_to "‹", dashboard_calendar_path(view: @view, date: (@date - (@view == "minggu" ? 7 : (@view == "bulan" ? 30 : 1)))), class: "btn-secondary btn-sm px-3" %>
    <span class="min-w-36 text-center text-sm font-bold"><%= l(@date, format: "%B %Y") rescue @date.strftime("%B %Y") %></span>
    <%= link_to "›", dashboard_calendar_path(view: @view, date: (@date + (@view == "minggu" ? 7 : (@view == "bulan" ? 30 : 1)))), class: "btn-secondary btn-sm px-3" %>
    <%= link_to "Hari Ini", dashboard_calendar_path(view: @view), class: "btn-secondary btn-sm" %>
  </div>
</div>

<% if @view == "hari" %>
  <!-- Day timeline -->
  <div class="card mt-5 overflow-x-auto p-0">
    <div class="min-w-[640px]">
      <div class="grid border-b border-gray-100 text-sm font-bold" style="grid-template-columns: 70px repeat(<%= [@staff_members.size, 1].max %>, 1fr);">
        <div class="px-3 py-3 text-xs text-ink-500">Waktu</div>
        <% @staff_members.each do |s| %>
          <div class="px-3 py-3"><%= s.name %></div>
        <% end %>
        <% if @staff_members.empty? %><div class="px-3 py-3">Semua Booking</div><% end %>
      </div>
      <% (Dashboard::CalendarsController::DAY_START...21).each do |hour| %>
        <div class="grid border-b border-gray-50" style="grid-template-columns: 70px repeat(<%= [@staff_members.size, 1].max %>, 1fr);">
          <div class="border-r border-gray-50 px-3 py-3 text-xs text-ink-500"><%= format("%02d:00", hour) %></div>
          <% cols = @staff_members.empty? ? [nil] : @staff_members %>
          <% cols.each do |s| %>
            <div class="relative min-h-16 border-r border-gray-50 p-1">
              <% items = @day_bookings.select { |b| b.start_time.hour == hour && (s.nil? || b.booking_items.any? { |i| i.staff_id == s.id }) } %>
              <% items.each do |b| %>
                <% item = b.booking_items.first %>
                <div class="rounded-lg border p-2 text-xs leading-tight <%= b.status == 'completed' ? 'border-gray-200 bg-gray-50' : (item&.staff_id ? 'border-primary-200 bg-primary-50' : 'border-amber-200 bg-amber-50') %>">
                  <p class="font-bold"><%= b.start_time.strftime("%H:%M") %>–<%= b.end_time.strftime("%H:%M") %></p>
                  <p class="truncate"><%= item&.label %></p>
                  <p class="truncate text-ink-500"><%= b.user.full_name %></p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

<% elsif @view == "minggu" %>
  <!-- Week grid -->
  <div class="card mt-5 overflow-x-auto p-4">
    <div class="grid min-w-[700px] grid-cols-7 gap-2">
      <% (0...7).each do |i| %>
        <% day = @week_start + i %>
        <% day_bookings = @week_bookings[day] || [] %>
        <div class="<%= 'rounded-xl border border-primary-200 bg-primary-50/40' if day == Date.current %> rounded-xl border border-gray-100 p-2">
          <p class="text-center text-xs font-bold text-ink-500"><%= t("date.abbr_day_names")[(day.wday + 6) % 7] %></p>
          <p class="text-center text-lg font-extrabold <%= 'text-primary-600' if day == Date.current %>"><%= day.day %></p>
          <div class="mt-2 space-y-1.5">
            <% day_bookings.sort_by(&:start_time).each do |b| %>
              <%= link_to dashboard_bookings_path, class: "block rounded-lg bg-primary-50 p-1.5 text-[11px] leading-tight hover:bg-primary-100" do %>
                <span class="font-bold text-primary-700"><%= b.start_time.strftime("%H:%M") %></span>
                <span class="block truncate text-ink-700"><%= b.booking_items.first&.label %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

<% else %>
  <!-- Month grid -->
  <div class="card mt-5 p-4">
    <% first = @date.beginning_of_month %>
    <% lead = (first.wday + 6) % 7 %>
    <div class="grid grid-cols-7 gap-1 text-center text-xs font-bold text-ink-500">
      <% %w[Sen Sel Rab Kam Jum Sab Min].each do |d| %><span class="py-1"><%= d %></span><% end %>
    </div>
    <div class="mt-1 grid grid-cols-7 gap-1">
      <% lead.times do %><span></span><% end %>
      <% (1..first.end_of_month.day).each do |d| %>
        <% day = first + (d - 1) %>
        <% count = (@month_bookings[day] || []).size %>
        <div class="min-h-20 rounded-lg border p-1.5 text-left <%= 'border-primary-200 bg-primary-50/40' if day == Date.current %> <%= 'border-gray-100' if day != Date.current %>">
          <p class="text-xs font-bold <%= 'text-primary-600' if day == Date.current %>"><%= d %></p>
          <% if count > 0 %>
            <span class="mt-1 inline-block rounded-full bg-primary-600 px-1.5 py-0.5 text-[10px] font-bold text-white"><%= count %> booking</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
