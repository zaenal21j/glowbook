<% content_for :sidebar_links do %>
  <%= render "dashboard/shared/sidebar" %>
<% end %>
<% content_for :page_title, t("dashboard.settings_page.title") + " — GlowBook" %>

<div class="max-w-2xl space-y-5">
  <div class="mb-1">
    <h1 class="text-xl font-extrabold"><%= t("dashboard.settings_page.title") %></h1>
  </div>

  <div class="card p-6">
    <h3 class="font-semibold"><%= t("dashboard.settings_page.business_account") %></h3>
    <div class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between border-b border-line pb-3"><span class="text-ink-500"><%= t("dashboard.settings_page.owner") %></span><strong><%= @business.owner.full_name %></strong></div>
      <div class="flex justify-between border-b border-line pb-3"><span class="text-ink-500"><%= t("dashboard.settings_page.email") %></span><strong><%= @business.owner.email %></strong></div>
      <div class="flex justify-between border-b border-line pb-3"><span class="text-ink-500"><%= t("dashboard.settings_page.page_slug") %></span><strong class="font-mono">/b/<%= @business.slug %></strong></div>
      <div class="flex justify-between"><span class="text-ink-500"><%= t("dashboard.settings_page.status") %></span><span class="badge badge-success"><%= t("admin.businesses.#{@business.status}", default: @business.status.humanize) %></span></div>
    </div>
  </div>

  <div class="card p-6">
    <h3 class="font-semibold"><%= t("dashboard.settings_page.preferences") %></h3>
    <div class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between border-b border-line pb-3"><span class="text-ink-500"><%= t("dashboard.settings_page.auto_confirmation") %></span><span class="badge badge-success"><%= t("dashboard.settings_page.active") %></span></div>
      <div class="flex justify-between border-b border-line pb-3"><span class="text-ink-500"><%= t("dashboard.settings_page.customer_cancellation") %></span><span class="badge badge-success"><%= t("dashboard.settings_page.allowed") %></span></div>
      <div class="flex justify-between"><span class="text-ink-500"><%= t("dashboard.settings_page.payment") %></span><strong><%= t("dashboard.settings_page.pay_at_venue") %></strong></div>
    </div>
  </div>

  <div class="card border-red-100 p-6">
    <h3 class="font-semibold text-red-600"><%= t("dashboard.settings_page.danger_zone") %></h3>
    <p class="mt-1 text-sm text-ink-500"><%= t("dashboard.settings_page.suspend_help") %></p>
    <p class="mt-3 text-xs text-ink-400"><%= t("dashboard.settings_page.support_help") %></p>
  </div>
</div>
