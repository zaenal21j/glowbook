<% content_for :sidebar_links do %>
  <%= render "dashboard/shared/sidebar" %>
<% end %>
<% content_for :page_title, "Pelanggan — GlowBook" %>

<div class="mb-4">
  <h1 class="text-xl font-extrabold">Pelanggan</h1>
  <p class="text-sm text-ink-500"><%= @total_customer_count %> pelanggan pernah booking di bisnis Anda.</p>
</div>

<div class="card overflow-x-auto p-0">
  <table class="w-full text-sm">
    <thead class="border-b border-line bg-surface-50 text-left text-xs uppercase tracking-wide text-ink-400">
      <tr><th class="p-3">Pelanggan</th><th class="p-3">Total Booking</th><th class="p-3">Total Belanja</th><th class="p-3">Kunjungan Terakhir</th></tr>
    </thead>
    <tbody>
      <% @customers.each do |c| %>
        <tr class="border-b border-line last:border-0">
          <td class="p-3">
            <div class="flex items-center gap-2.5">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-100 text-xs font-bold text-primary-700"><%= c.full_name.first %></div>
              <div>
                <p class="font-medium"><%= c.full_name %></p>
                <p class="text-xs text-ink-400"><%= c.email %></p>
              </div>
            </div>
          </td>
          <td class="p-3 font-semibold"><%= c.bookings_count %></td>
          <td class="p-3"><%= number_to_currency(c.total_spent.to_f, unit: "Rp ", delimiter: ".", precision: 0) %></td>
          <td class="p-3 text-ink-500"><%= c.last_visit ? c.last_visit.strftime("%d %b %Y, %H:%M") : "—" %></td>
        </tr>
      <% end %>
      <% if @customers.empty? %><tr><td colspan="4" class="p-8 text-center text-ink-500">Belum ada pelanggan.</td></tr><% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination" %>
