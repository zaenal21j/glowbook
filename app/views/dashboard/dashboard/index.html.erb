<%= render "dashboard/shared/sidebar" %>
<% content_for :page_title, t("dashboard.home.title") %>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("dashboard.home.today") %></p>
    <p class="mt-1 text-3xl font-extrabold"><%= @today_count %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("dashboard.home.this_week") %></p>
    <p class="mt-1 text-3xl font-extrabold"><%= @week_count %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("dashboard.home.monthly_completed_value") %></p>
    <p class="mt-1 text-3xl font-extrabold text-primary-600"><%= format_idr(@revenue_month) %></p>
    <p class="mt-1 text-xs text-ink-400"><%= t("dashboard.home.revenue_note") %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("dashboard.home.rating") %></p>
    <p class="mt-1 text-3xl font-extrabold">⭐ <%= @rating || "—" %></p>
  </div>
</div>

<section class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-extrabold"><%= t("dashboard.home.upcoming") %></h2>
    <%= link_to t("dashboard.home.calendar"), dashboard_calendar_path, class: "text-sm font-semibold text-primary-600" %>
  </div>
  <div class="card mt-4 overflow-x-auto">
    <%= render "shared/table_controls", key: "bookings" %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wide text-ink-500">
          <th class="px-4 py-3"><%= t("dashboard.home.customer") %></th>
          <th class="px-4 py-3"><%= t("dashboard.home.service") %></th>
          <th class="px-4 py-3"><%= t("dashboard.home.staff") %></th>
          <th class="px-4 py-3"><%= t("dashboard.home.time") %></th>
          <th class="px-4 py-3"><%= t("dashboard.home.status") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @upcoming.each do |booking| %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= booking.user.full_name %></td>
            <td class="px-4 py-3"><%= booking.booking_items.map(&:label).join(", ") %></td>
            <td class="px-4 py-3"><%= booking.booking_items.first&.staff&.name || "—" %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= l(booking.start_time, format: "%d %b, %H:%M") %></td>
            <td class="px-4 py-3"><span class="badge <%= booking.status_badge_class %>"><%= t("booking.status.#{booking.status}", default: booking.status.humanize) %></span></td>
          </tr>
        <% end %>
        <% if @upcoming.empty? %>
          <tr><td colspan="5" class="px-4 py-10 text-center text-ink-500"><%= t("dashboard.home.no_upcoming") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%= render "shared/table_pagination", key: "bookings" %>
