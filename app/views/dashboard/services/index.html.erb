<% content_for :sidebar_links do %>
  <%= render "dashboard/shared/sidebar" %>
<% end %>
<% content_for :page_title, "Layanan — GlowBook" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-xl font-extrabold">Layanan</h1>
    <p class="text-sm text-ink-500">Kelola katalog layanan bisnis Anda.</p>
  </div>
  <%= link_to "+ Layanan Baru", new_dashboard_manage_service_path, class: "btn-primary btn-md" %>
</div>

<div class="card mt-5 overflow-x-auto p-0">
  <table class="w-full text-sm">
    <thead class="border-b border-line bg-surface-50 text-left text-xs uppercase tracking-wide text-ink-400">
      <tr><th class="p-3">Layanan</th><th class="p-3">Kategori</th><th class="p-3">Durasi</th><th class="p-3">Harga</th><th class="p-3">Staff</th><th class="p-3">Status</th><th class="p-3"></th></tr>
    </thead>
    <tbody>
      <% @services.each do |s| %>
        <tr class="border-b border-line last:border-0">
          <td class="p-3 font-medium"><%= s.name %></td>
          <td class="p-3 text-ink-500"><%= s.category.name %></td>
          <td class="p-3"><%= s.duration_minutes %> mnt</td>
          <td class="p-3 font-semibold"><%= s.price_idr %></td>
          <td class="p-3 text-ink-500"><%= s.staff.count %> staff</td>
          <td class="p-3"><span class="badge <%= s.active? ? "badge-success" : "badge-muted" %>"><%= s.active? ? "Aktif" : "Nonaktif" %></span></td>
          <td class="p-3 text-right whitespace-nowrap">
            <%= link_to "Edit", edit_dashboard_manage_service_path(s), class: "text-xs font-semibold text-primary-600 hover:underline" %>
            <%= button_to "Hapus", dashboard_manage_service_path(s), method: :delete, form: { data: { turbo_confirm: "Hapus layanan ini?" } }, class: "ml-3 text-xs text-red-500 hover:underline" %>
          </td>
        </tr>
      <% end %>
      <% if @services.empty? %><tr><td colspan="7" class="p-8 text-center text-ink-500">Belum ada layanan. Tambahkan layanan pertama Anda.</td></tr><% end %>
    </tbody>
  </table>
</div>
