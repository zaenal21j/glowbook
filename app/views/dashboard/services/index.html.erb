<% content_for :sidebar_links do %>
  <%= render "dashboard/shared/sidebar" %>
<% end %>
<% content_for :page_title, "#{t('business_management.services.title')} — GlowBook" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-xl font-extrabold"><%= t("business_management.services.title") %></h1>
    <p class="text-sm text-ink-500"><%= t("business_management.services.description") %></p>
  </div>
  <%= link_to "+ #{t('business_management.services.new')}", new_dashboard_manage_service_path, class: "btn-primary btn-md" %>
</div>

<div class="card mt-5 overflow-x-auto p-0">
  <table class="w-full text-sm">
    <thead class="border-b border-line bg-surface-50 text-left text-xs uppercase tracking-wide text-ink-400">
      <tr><th class="p-3"><%= t("business_management.services.title") %></th><th class="p-3"><%= t("business_management.services.category") %></th><th class="p-3"><%= t("business_management.services.duration") %></th><th class="p-3"><%= t("business_management.services.price") %></th><th class="p-3"><%= t("business_management.staff.title") %></th><th class="p-3"><%= t("business_management.services.status") %></th><th class="p-3"></th></tr>
    </thead>
    <tbody>
      <% @services.each do |s| %>
        <tr class="border-b border-line last:border-0">
          <td class="p-3 font-medium"><%= s.name %></td>
          <td class="p-3 text-ink-500"><%= s.category.name %></td>
          <td class="p-3"><%= t("business_management.staff.duration", count: s.duration_minutes) %></td>
          <td class="p-3 font-semibold"><%= s.price_idr %></td>
          <td class="p-3 text-ink-500"><%= t("business_management.services.staff_count", count: s.staff.count) %></td>
          <td class="p-3"><span class="badge <%= s.active? ? "badge-success" : "badge-muted" %>"><%= t(s.active? ? "business_management.services.active" : "business_management.services.inactive") %></span></td>
          <td class="p-3 text-right whitespace-nowrap">
            <%= link_to t("business_management.services.edit"), edit_dashboard_manage_service_path(s), class: "text-xs font-semibold text-primary-600 hover:underline" %>
            <%= button_to t("business_management.services.delete"), dashboard_manage_service_path(s), method: :delete, form: { data: { turbo_confirm: t("business_management.services.delete_confirm") } }, class: "ml-3 text-xs text-red-500 hover:underline" %>
          </td>
        </tr>
      <% end %>
      <% if @services.empty? %><tr><td colspan="7" class="p-8 text-center text-ink-500"><%= t("business_management.services.empty") %></td></tr><% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination" %>
