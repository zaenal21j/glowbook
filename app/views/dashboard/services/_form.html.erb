<%= form_with model: service, url: service.persisted? ? dashboard_manage_service_path(service) : dashboard_manage_services_path, class: "space-y-4" do |f| %>
  <%= render "shared/form_errors", record: service %>
  <div>
    <%= f.label :name, t("business_management.services.name"), class: "label" %>
    <%= f.text_field :name, class: "input", required: true, placeholder: t("business_management.services.example") %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :category_id, t("business_management.services.category"), class: "label" %>
      <%= f.collection_select :category_id, @categories || Category.ordered, :id, :name, { prompt: t("business_management.services.choose_category") }, class: "input", required: true %>
    </div>
    <div>
      <%= f.label :price, t("business_management.services.price"), class: "label" %>
      <%= f.number_field :price, class: "input", min: 0, step: 1000, required: true %>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :duration_minutes, t("business_management.services.duration"), class: "label" %>
      <%= f.number_field :duration_minutes, class: "input", min: 15, step: 15, required: true %>
    </div>
    <div>
      <%= f.label :position, t("business_management.services.order"), class: "label" %>
      <%= f.number_field :position, class: "input", min: 0 %>
    </div>
  </div>
  <div>
    <%= f.label :description, t("business_management.services.description_label"), class: "label" %>
    <%= f.text_area :description, rows: 3, class: "input", placeholder: t("business_management.services.description_placeholder") %>
  </div>
  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :active, class: "h-4 w-4 rounded accent-primary-600" %>
    <%= t("business_management.services.active_help") %>
  </label>
  <div class="flex gap-2 pt-2">
    <button class="btn-primary btn-md flex-1"><%= t("business_management.services.save") %></button>
    <%= link_to t("business_management.services.cancel"), dashboard_services_path, class: "btn-ghost btn-md" %>
  </div>
<% end %>
