<% content_for :sidebar_links do %>
  <%= render "dashboard/shared/sidebar" %>
<% end %>
<% content_for :page_title, "Staff — GlowBook" %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-xl font-extrabold">Staff</h1>
    <p class="text-sm text-ink-500">Kelola tim dan jadwal kerja mereka.</p>
  </div>
  <%= link_to "+ Staff Baru", new_dashboard_manage_staff_path, class: "btn-primary btn-md" %>
</div>

<div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @staff.each do |m| %>
    <div class="card p-5">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-100 text-primary-700 font-bold"><%= m.name.first %></div>
          <div>
            <p class="font-semibold"><%= m.name %></p>
            <p class="text-xs text-ink-500"><%= m.display_title %></p>
          </div>
        </div>
        <span class="badge <%= m.active? ? "badge-success" : "badge-muted" %>"><%= m.active? ? "Aktif" : "Nonaktif" %></span>
      </div>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <% m.services.limit(4).each do |s| %>
          <span class="chip"><%= s.name %></span>
        <% end %>
        <% if m.services.count > 4 %><span class="chip">+<%= m.services.count - 4 %></span><% end %>
      </div>
      <div class="mt-3 flex flex-wrap gap-1 text-xs text-ink-500">
        <% BusinessHour.days.each_with_index do |day, i| %>
          <span class="<%= 'font-bold text-primary-600' if m.works_on?(i) %>"><%= day.first %></span>
        <% end %>
      </div>
      <div class="mt-4 flex gap-3 border-t border-line pt-3 text-xs">
        <%= link_to "Edit", edit_dashboard_manage_staff_path(m), class: "font-semibold text-primary-600 hover:underline" %>
        <%= button_to "Hapus", dashboard_manage_staff_path(m), method: :delete, form: { data: { turbo_confirm: "Hapus staff ini?" } }, class: "text-red-500 hover:underline" %>
      </div>
    </div>
  <% end %>
  <% if @staff.empty? %>
    <div class="card p-10 text-center text-ink-500 md:col-span-2 xl:col-span-3">Belum ada staff. Tambahkan staff pertama Anda.</div>
  <% end %>
</div>

<%= render "shared/pagination" %>
