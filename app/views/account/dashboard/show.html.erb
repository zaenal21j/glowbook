<% content_for :page_title, t("account.customer.dashboard_title") %>

<div class="grid gap-4 sm:grid-cols-3">
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("account.customer.total_bookings") %></p>
    <p class="mt-1 text-3xl font-extrabold"><%= @total_bookings %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("account.customer.completed") %></p>
    <p class="mt-1 text-3xl font-extrabold"><%= @completed_count %></p>
  </div>
  <div class="card p-5">
    <p class="text-sm text-ink-500"><%= t("account.favorites") %></p>
    <p class="mt-1 text-3xl font-extrabold"><%= @favorites_count %></p>
  </div>
</div>

<section class="mt-8">
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-extrabold"><%= t("account.customer.upcoming") %></h2>
    <%= link_to t("account.customer.see_all"), account_bookings_path, class: "text-sm font-semibold text-primary-600" %>
  </div>
  <div class="mt-4 space-y-4">
    <% if @upcoming.any? %>
      <% @upcoming.each do |booking| %>
        <%= render "account/bookings/booking_row", booking: booking %>
      <% end %>
    <% else %>
      <div class="card p-10 text-center">
        <p class="text-3xl">📅</p>
        <p class="mt-3 font-bold"><%= t("account.customer.no_upcoming") %></p>
        <p class="mt-1 text-sm text-ink-500"><%= t("account.customer.first_booking_prompt") %></p>
        <%= link_to t("account.customer.explore"), search_path, class: "btn-primary btn-md mt-5" %>
      </div>
    <% end %>
  </div>
</section>
