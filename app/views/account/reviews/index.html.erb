<% content_for :page_title, "Ulasan Saya" %>

<div class="space-y-4">
  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <div class="card p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <%= link_to review.business.name, business_detail_path(review.business.slug), class: "font-bold hover:text-primary-700" %>
            <p class="text-xs text-ink-500"><%= review.created_at.strftime("%d %B %Y") %></p>
          </div>
          <span class="text-amber-400"><%= review.stars %></span>
        </div>
        <% if review.comment.present? %>
          <p class="mt-3 text-sm text-ink-700"><%= review.comment %></p>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="card p-10 text-center">
      <p class="text-3xl">⭐</p>
      <p class="mt-3 font-bold">Belum ada ulasan</p>
      <p class="mt-1 text-sm text-ink-500">Bagikan pengalamanmu setelah mengunjungi salon.</p>
    </div>
  <% end %>
</div>

<%= render "shared/pagination" %>
