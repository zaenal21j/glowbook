<% content_for :page_title, t("account.customer.profile_title") %>

<div class="card max-w-xl p-6">
  <%= form_with model: @user, url: account_profile_path, method: :patch, class: "space-y-4" do |f| %>
    <%= render "shared/form_errors", record: @user %>
    <div>
      <%= f.label :name, t("account.customer.full_name"), class: "label" %>
      <%= f.text_field :name, class: "input" %>
    </div>
    <div>
      <%= f.label :email, t("account.customer.email"), class: "label" %>
      <%= f.email_field :email, class: "input" %>
    </div>
    <div>
      <%= f.label :current_password, t("account.security.current_password"), class: "label" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "input" %>
      <p class="mt-1 text-xs text-ink-500"><%= t("account.security.email_password_help") %></p>
    </div>
    <div>
      <%= f.label :phone, t("account.customer.phone"), class: "label" %>
      <%= f.telephone_field :phone, class: "input", placeholder: "081234567890" %>
    </div>
    <%= f.submit t("account.customer.save_changes"), class: "btn-primary btn-lg w-full" %>
  <% end %>
</div>
