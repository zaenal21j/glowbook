<% content_for :page_title, t("account.customer.settings_title") %>

<div class="max-w-xl space-y-6">
  <div class="card p-6">
    <h2 class="font-extrabold"><%= t("account.customer.change_password") %></h2>
    <p class="mt-1 text-sm text-ink-500"><%= t("account.customer.password_help") %></p>
    <div class="mt-4">
      <%= link_to t("account.customer.send_reset_link"), new_password_path(:user), class: "btn-secondary btn-md" %>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-extrabold"><%= t("account.customer.account") %></h2>
    <div class="mt-4 space-y-3 text-sm">
      <div class="flex items-center justify-between">
        <span class="text-ink-500"><%= t("account.customer.email") %></span>
        <span class="font-medium"><%= current_user.email %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-ink-500"><%= t("account.customer.sign_in_method") %></span>
        <span class="badge <%= current_user.provider == 'facebook' ? 'badge-pink' : 'badge-gray' %>"><%= current_user.provider == "facebook" ? "Facebook" : "Email" %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-ink-500"><%= t("account.customer.role") %></span>
        <span class="badge badge-gray"><%= t("account.customer.roles.#{current_user.role}", default: current_user.role.humanize) %></span>
      </div>
    </div>
    <%= button_to t("account.customer.sign_out"), logout_path, method: :delete, class: "btn-danger btn-md mt-6 w-full" %>
  </div>
</div>
