<% content_for :page_title, t("account.bookings") %>
<%= render "shared/table_controls", key: "bookings" %>

<div class="flex gap-2 overflow-x-auto scrollbar-none">
  <%= link_to t("account.customer.upcoming_tab"), account_bookings_path, class: "chip #{'chip-active' if @tab == 'akan-datang'}" %>
  <%= link_to t("account.customer.completed_tab"), account_bookings_path(tab: "selesai"), class: "chip #{'chip-active' if @tab == 'selesai'}" %>
  <%= link_to t("account.customer.cancelled_tab"), account_bookings_path(tab: "dibatalkan"), class: "chip #{'chip-active' if @tab == 'dibatalkan'}" %>
</div>

<div class="mt-5 space-y-4">
  <% if @bookings.any? %>
    <% @bookings.each do |booking| %>
      <%= render "account/bookings/booking_row", booking: booking %>
    <% end %>
  <% else %>
    <div class="card p-10 text-center">
      <p class="text-3xl">🗓️</p>
      <p class="mt-3 font-bold"><%= t("account.customer.empty_bookings") %></p>
      <%= link_to t("account.customer.book_now"), search_path, class: "btn-primary btn-md mt-4" %>
    </div>
  <% end %>
</div>

<%= render "shared/table_pagination", key: "bookings" %>
