<% content_for :title, "GlowBook — Booking Kecantikan & Wellness Terbaik" %>

<!-- Hero -->
<section class="relative overflow-hidden bg-gradient-to-b from-primary-50/80 via-primary-50/30 to-white">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pb-16 pt-10 lg:grid-cols-2 lg:px-8 lg:pb-24 lg:pt-16">
    <div>
      <h1 class="text-balance text-4xl font-extrabold leading-tight tracking-tight text-ink-900 lg:text-5xl">
        Temukan layanan kecantikan &amp; wellness terbaik di dekatmu
      </h1>
      <p class="mt-4 max-w-md text-ink-500">
        Booking salon, spa, barber, dan banyak lagi dengan mudah dan cepat.
      </p>

      <%= form_with url: search_path, method: :get, class: "mt-8 rounded-2xl border border-gray-100 bg-white p-2 shadow-lg shadow-primary-900/5" do |f| %>
        <div class="grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
          <%= f.text_field :q, placeholder: "Layanan apa? (mis. facial)", class: "input border-0 bg-transparent shadow-none focus:ring-0", value: params[:q], aria: { label: "Layanan" } %>
          <%= f.select :city, City.order(:name).pluck(:name, :slug), { include_blank: "Semua Kota" }, class: "input border-0 bg-transparent shadow-none focus:ring-0", "aria-label": "Kota" %>
          <%= f.submit "Cari", class: "btn-primary btn-md px-8" %>
        </div>
      <% end %>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium text-ink-500">Populer:</span>
        <% ["Facial", "Haircut", "Massage", "Manicure"].each do |tag| %>
          <%= link_to tag, search_path(q: tag.downcase), class: "chip" %>
        <% end %>
      </div>
    </div>
    <div class="relative hidden lg:block">
      <div class="overflow-hidden rounded-3xl shadow-2xl shadow-primary-900/20">
        <img src="https://picsum.photos/seed/glowbook-hero/900/720" alt="Salon premium" class="aspect-[5/4] w-full object-cover" />
      </div>
      <div class="card absolute -bottom-6 -left-8 flex items-center gap-3 p-4">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
        </span>
        <div>
          <p class="text-sm font-bold">Booking Terkonfirmasi</p>
          <p class="text-xs text-ink-500">Instan &amp; tanpa biaya</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Kategori Populer -->
<section class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
  <div class="flex items-end justify-between">
    <h2 class="text-2xl font-extrabold tracking-tight">Kategori Populer</h2>
    <%= link_to "Lihat semua >", search_path, class: "text-sm font-semibold text-primary-600 hover:text-primary-700" %>
  </div>
  <div class="mt-6 grid grid-cols-4 gap-3 sm:grid-cols-6 lg:grid-cols-10 lg:gap-4">
    <% @categories.each do |category| %>
      <%= link_to category_path(category.slug), class: "group flex flex-col items-center gap-2 rounded-2xl border border-gray-100 bg-white p-3 text-center transition hover:border-primary-200 hover:bg-primary-50/50" do %>
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-50 text-primary-600 transition group-hover:bg-primary-600 group-hover:text-white">
          <% if category.icon_path %>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= category.icon_path %>" /></svg>
          <% else %>
            <span class="text-lg font-bold"><%= category.name[0] %></span>
          <% end %>
        </span>
        <span class="text-xs font-semibold text-ink-700"><%= category.name %></span>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Salon Populer -->
<section class="bg-gray-50/60 py-12">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight">Salon Populer di <%= @featured_city&.name || "Indonesia" %></h2>
        <p class="mt-1 text-sm text-ink-500">Rating tertinggi dengan ribuan ulasan pelanggan</p>
      </div>
      <%= link_to "Lihat semua >", search_path(city: @featured_city&.slug), class: "text-sm font-semibold text-primary-600 hover:text-primary-700" %>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% @featured_businesses.each do |business| %>
        <%= render "shared/business_card", business: business %>
      <% end %>
    </div>
  </div>
</section>

<!-- Rekomendasi lain -->
<section class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
  <div class="flex items-end justify-between">
    <h2 class="text-2xl font-extrabold tracking-tight">Rekomendasi Untukmu</h2>
    <%= link_to "Lihat semua >", search_path, class: "text-sm font-semibold text-primary-600 hover:text-primary-700" %>
  </div>
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <% @recommended_businesses.each do |business| %>
      <%= render "shared/business_card", business: business %>
    <% end %>
  </div>
</section>

<!-- CTA Untuk Bisnis -->
<section class="mx-auto max-w-7xl px-4 pb-16 lg:px-8">
  <div class="relative overflow-hidden rounded-3xl bg-ink-900 px-8 py-12 text-white lg:px-14">
    <div class="relative z-10 max-w-lg">
      <h2 class="text-3xl font-extrabold tracking-tight">Kelola bisnis kecantikanmu dengan GlowBook</h2>
      <p class="mt-3 text-white/70">Kalender cerdas, manajemen staff, dan analitik — semua dalam satu dashboard.</p>
      <%= link_to "Daftarkan Bisnis", for_business_path, class: "btn-primary btn-lg mt-6" %>
    </div>
    <div class="absolute -right-10 -top-10 h-64 w-64 rounded-full bg-primary-600/30 blur-3xl"></div>
  </div>
</section>
