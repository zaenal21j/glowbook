<% content_for :page_title, "Daftarkan Bisnis Anda" %>

<div class="mx-auto max-w-2xl px-4 py-12">
  <div class="card p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold">Daftarkan Bisnis Anda</h1>
    <p class="mt-2 text-sm text-ink-500">Buat profil awal, lalu lengkapi layanan dan staff dari dashboard. Bisnis akan ditinjau admin sebelum tampil di marketplace.</p>

    <% if !user_signed_in? %>
      <div class="mt-6 rounded-xl bg-primary-50 p-4 text-sm text-primary-800">
        Anda perlu masuk atau membuat akun pelanggan sebelum mendaftarkan bisnis.
      </div>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= link_to "Masuk", login_path, class: "btn-primary btn-md" %>
        <%= link_to "Buat Akun", signup_path, class: "btn-secondary btn-md" %>
      </div>
    <% elsif current_user.businesses.exists? %>
      <div class="mt-6 rounded-xl bg-primary-50 p-4 text-sm text-primary-800">
        Akun ini sudah memiliki bisnis. Kelola data bisnis dari dashboard.
      </div>
      <%= link_to "Buka Dashboard Bisnis", dashboard_root_path, class: "btn-primary btn-md mt-5" %>
    <% elsif !current_user.customer? && !current_user.business_owner? %>
      <div class="mt-6 rounded-xl bg-amber-50 p-4 text-sm text-amber-800">
        Peran akun ini tidak dapat mendaftarkan bisnis. Gunakan akun pelanggan atau pemilik bisnis.
      </div>
    <% else %>
      <% if @business.errors.any? %>
        <div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <ul class="list-inside list-disc">
            <% @business.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @business, url: buat_registrasi_bisnis_path, class: "mt-6 space-y-4" do |f| %>
        <div>
          <%= f.label :name, "Nama bisnis", class: "label" %>
          <%= f.text_field :name, required: true, maxlength: 150, class: "input", placeholder: "Contoh: Bellezza Hair Studio" %>
        </div>
        <div>
          <%= f.label :phone, "Nomor telepon / WhatsApp", class: "label" %>
          <%= f.telephone_field :phone, required: true, maxlength: 16, class: "input", placeholder: "+62812xxxxxxx" %>
          <p class="mt-1 text-xs text-ink-400">Gunakan kode negara, misalnya +6281234567890.</p>
        </div>
        <div>
          <%= f.label :city_id, "Kota", class: "label" %>
          <%= f.collection_select :city_id, @cities, :id, :name, { include_blank: "Pilih kota" }, { required: true, class: "input" } %>
        </div>
        <div>
          <%= f.label :address, "Alamat lengkap", class: "label" %>
          <%= f.text_field :address, required: true, maxlength: 255, class: "input", placeholder: "Nama jalan, nomor, dan area" %>
        </div>
        <fieldset>
          <legend class="label">Kategori bisnis</legend>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <% @categories.each do |category| %>
              <label class="flex items-center gap-2 rounded-lg border border-line p-3 text-sm">
                <%= check_box_tag "business[category_ids][]", category.id, Array(params.dig(:business, :category_ids)).include?(category.id.to_s), class: "rounded border-line text-primary-600" %>
                <%= category.name %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <p class="text-xs text-ink-500">Jam awal diatur Senin–Sabtu 09.00–17.00 dan Minggu tutup. Setelah mendaftar, hubungi dukungan untuk perubahan jam operasional.</p>
        <%= f.submit "Daftarkan Bisnis", class: "btn-primary btn-md w-full" %>
      <% end %>
    <% end %>
  </div>
</div>
