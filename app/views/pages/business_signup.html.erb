<% content_for :page_title, t("business_signup.title") %>

<div class="mx-auto max-w-2xl px-4 py-12">
  <div class="card p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold"><%= t("business_signup.title") %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t("business_signup.description") %></p>

    <% if !@business_registrations_open %>
      <div class="mt-6 rounded-xl bg-amber-50 p-4 text-sm text-amber-800">
        <%= t("business_signup.closed") %>
      </div>
    <% elsif !user_signed_in? %>
      <div class="mt-6 rounded-xl bg-primary-50 p-4 text-sm text-primary-800">
        <%= t("business_signup.sign_in_required") %>
      </div>
      <div class="mt-5 flex flex-wrap gap-3">
        <%= link_to t("business_signup.sign_in"), login_path, class: "btn-primary btn-md" %>
        <%= link_to t("business_signup.create_account"), signup_path, class: "btn-secondary btn-md" %>
      </div>
    <% elsif current_user.businesses.exists? %>
      <div class="mt-6 rounded-xl bg-primary-50 p-4 text-sm text-primary-800">
        <%= t("business_signup.already_has_business") %>
      </div>
      <%= link_to t("business_signup.open_dashboard"), dashboard_root_path, class: "btn-primary btn-md mt-5" %>
    <% elsif !current_user.customer? && !current_user.business_owner? %>
      <div class="mt-6 rounded-xl bg-amber-50 p-4 text-sm text-amber-800">
        <%= t("business_signup.role_not_allowed") %>
      </div>
    <% else %>
      <% if @business.errors.any? %>
        <div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <ul class="list-inside list-disc">
            <% @business.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @business, url: buat_registrasi_bisnis_path, class: "mt-6 space-y-4" do |f| %>
        <div>
          <%= f.label :name, t("business_signup.business_name"), class: "label" %>
          <%= f.text_field :name, required: true, maxlength: 150, class: "input", placeholder: t("business_signup.business_name_example") %>
        </div>
        <div>
          <%= f.label :phone, t("business_signup.phone"), class: "label" %>
          <%= f.telephone_field :phone, required: true, maxlength: 16, class: "input", placeholder: "+62812xxxxxxx" %>
          <p class="mt-1 text-xs text-ink-400"><%= t("business_signup.country_code_help") %></p>
        </div>
        <div>
          <%= f.label :city_id, t("business_signup.city"), class: "label" %>
          <%= f.collection_select :city_id, @cities, :id, :name, { include_blank: t("business_signup.choose_city") }, { required: true, class: "input" } %>
        </div>
        <div>
          <%= f.label :address, t("business_signup.address"), class: "label" %>
          <%= f.text_field :address, required: true, maxlength: 255, class: "input", placeholder: t("business_signup.address_example") %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :latitude, t("business_signup.latitude"), class: "label" %>
            <%= f.number_field :latitude, min: -90, max: 90, step: "0.000001", class: "input" %>
          </div>
          <div>
            <%= f.label :longitude, t("business_signup.longitude"), class: "label" %>
            <%= f.number_field :longitude, min: -180, max: 180, step: "0.000001", class: "input" %>
          </div>
        </div>
        <p class="-mt-2 text-xs text-ink-500"><%= t("business_signup.coordinates_help") %></p>
        <fieldset>
          <legend class="label"><%= t("business_signup.categories") %></legend>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <% @categories.each do |category| %>
              <label class="flex items-center gap-2 rounded-lg border border-line p-3 text-sm">
                <%= check_box_tag "business[category_ids][]", category.id, Array(params.dig(:business, :category_ids)).include?(category.id.to_s), class: "rounded border-line text-primary-600" %>
                <%= category.name %>
              </label>
            <% end %>
          </div>
        </fieldset>
        <p class="text-xs text-ink-500"><%= t("business_signup.hours_help") %></p>
        <%= f.submit t("business_signup.submit"), class: "btn-primary btn-md w-full" %>
      <% end %>
    <% end %>
  </div>
</div>
