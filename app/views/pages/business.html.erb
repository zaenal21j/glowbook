<% content_for :page_title, t("for_business_page.title") %>

<div class="max-w-3xl mx-auto text-center py-16">
  <span class="badge badge-primary"><%= t("for_business_page.title") %></span>
  <h1 class="mt-4 text-4xl font-extrabold tracking-tight"><%= t("for_business_page.headline") %></h1>
  <p class="mt-4 text-lg text-ink-500"><%= t("for_business_page.description") %></p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <%= link_to t("for_business_page.register"), registrasi_bisnis_path, class: "btn-primary btn-lg" %>
    <%= link_to t("for_business_page.features_link"), "#business-features", class: "btn-secondary btn-lg" %>
  </div>
</div>

<div id="business-features" class="grid gap-6 md:grid-cols-3 max-w-5xl mx-auto pb-20">
  <div class="card p-6">
    <div class="text-3xl">📅</div>
    <h3 class="mt-3 font-bold"><%= t("for_business_page.features.calendar_title") %></h3>
    <p class="mt-2 text-sm text-ink-500"><%= t("for_business_page.features.calendar_description") %></p>
  </div>
  <div class="card p-6">
    <div class="text-3xl">📈</div>
    <h3 class="mt-3 font-bold"><%= t("for_business_page.features.analytics_title") %></h3>
    <p class="mt-2 text-sm text-ink-500"><%= t("for_business_page.features.analytics_description") %></p>
  </div>
  <div class="card p-6">
    <div class="text-3xl">⭐</div>
    <h3 class="mt-3 font-bold"><%= t("for_business_page.features.reviews_title") %></h3>
    <p class="mt-2 text-sm text-ink-500"><%= t("for_business_page.features.reviews_description") %></p>
  </div>
</div>

<div class="card p-8 max-w-5xl mx-auto mb-16">
  <h3 class="text-xl font-bold text-center"><%= t("for_business_page.pricing_title") %></h3>
  <div class="mt-6 max-w-xl mx-auto">
    <div class="rounded-2xl border border-line p-6">
      <p class="font-semibold"><%= t("for_business_page.trial") %></p>
      <p class="mt-1 text-3xl font-extrabold">Rp 0<span class="text-sm font-normal text-ink-400"><%= t("for_business_page.month") %></span></p>
      <p class="mt-2 text-sm text-ink-500"><%= t("for_business_page.trial_note") %></p>
      <ul class="mt-4 space-y-2 text-sm text-ink-600">
        <li>✓ <%= t("for_business_page.free_features.profile") %></li>
        <li>✓ <%= t("for_business_page.free_features.booking") %></li>
        <li>✓ <%= t("for_business_page.free_features.commission") %></li>
      </ul>
    </div>
  </div>
</div>
