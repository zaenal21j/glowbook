<% content_for :page_title, t("review_page.title", business: @business.name) %>

<div class="max-w-lg mx-auto py-12 px-4">
  <div class="card p-8">
    <h1 class="text-xl font-extrabold"><%= t("review_page.write_review") %></h1>
    <p class="mt-1 text-sm text-ink-500"><%= t("review_page.for_business", business: @business.name) %></p>

    <%= form_with model: @review, url: business_reviews_path(@business.slug), class: "mt-6 space-y-4" do |f| %>
      <%= render "shared/form_errors", record: @review %>
      <div>
        <%= f.label :rating, t("review_page.rating"), class: "label" %>
        <div class="flex gap-1.5">
          <% (1..5).each do |n| %>
            <label class="cursor-pointer">
              <%= f.radio_button :rating, n, required: true, class: "peer sr-only" %>
              <span class="block w-10 h-10 rounded-full border border-line text-center leading-10 peer-checked:bg-primary-500 peer-checked:text-white peer-checked:border-primary-500 hover:border-primary-400 transition">★</span>
            </label>
          <% end %>
        </div>
      </div>
      <div>
        <%= f.label :comment, t("review_page.comment"), class: "label" %>
        <%= f.text_area :comment, rows: 4, class: "input", placeholder: t("review_page.prompt") %>
      </div>
      <button class="btn-primary btn-md w-full"><%= t("review_page.submit") %></button>
    <% end %>
  </div>
</div>
