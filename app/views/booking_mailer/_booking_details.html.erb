<ul>
  <li><%= t("booking_email.business") %>: <%= @booking.business.name %></li>
  <li><%= t("booking_email.services") %>: <%= @booking.booking_items.map(&:label).join(", ") %></li>
  <li><%= t("booking_email.date") %>: <%= I18n.l(@booking.start_time, format: "%A, %d %B %Y") %></li>
  <li><%= t("booking_email.time") %>: <%= I18n.l(@booking.start_time, format: "%H:%M") %>–<%= I18n.l(@booking.end_time, format: "%H:%M") %> WIB</li>
  <li><%= t("booking_email.status") %>: <%= t("booking.status.#{@booking.status}") %></li>
</ul>
