<%= t("booking_email.confirmation_title") %>

<%= t("booking_email.reference") %>: <%= @booking.reference %>
<%= t("booking_email.business") %>: <%= @booking.business.name %>
<%= t("booking_email.services") %>: <%= @booking.booking_items.map(&:label).join(", ") %>
<%= t("booking_email.date") %>: <%= I18n.l(@booking.start_time, format: "%A, %d %B %Y") %>
<%= t("booking_email.time") %>: <%= I18n.l(@booking.start_time, format: "%H:%M") %>–<%= I18n.l(@booking.end_time, format: "%H:%M") %> WIB
<%= t("booking_email.status") %>: <%= t("booking.status.#{@booking.status}") %>

<%= t("booking_email.confirmation_help") %>
<%= t("booking_email.see_booking") %>: <%= booking_url(@booking.reference) %>
