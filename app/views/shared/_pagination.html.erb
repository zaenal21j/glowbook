<% if @total_pages && @total_pages > 1 %>
  <nav class="mt-5 flex flex-wrap items-center justify-between gap-3" aria-label="<%= t('pagination.aria_label') %>">
    <p class="text-sm text-ink-500">
      <%= t("pagination.page_info", page: @page, pages: @total_pages, count: @total_count) %>
    </p>
    <div class="flex items-center gap-2">
      <% if @page > 1 %>
        <%= link_to t("pagination.previous"), url_for(request.query_parameters.merge(page: @page - 1)), class: "btn-secondary btn-sm" %>
      <% end %>
      <% if @page < @total_pages %>
        <%= link_to t("pagination.next"), url_for(request.query_parameters.merge(page: @page + 1)), class: "btn-secondary btn-sm" %>
      <% end %>
    </div>
  </nav>
<% end %>
