<%= link_to business_detail_path(business.slug), class: "card card-hover group block overflow-hidden" do %>
  <div class="relative aspect-[16/10] overflow-hidden bg-primary-50">
    <% if business.cover_image.attached? %>
      <%= image_tag business.cover_image, class: "h-full w-full object-cover transition duration-300 group-hover:scale-105", loading: "lazy", alt: business.name %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-3xl text-primary-300">
        <svg class="h-12 w-12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 3.2-1.8 5.4-3.6 7C6 10.9 4.5 13 4.5 15.5A7.5 7.5 0 0 0 12 23a7.5 7.5 0 0 0 7.5-7.5c0-3.4-2.3-5.4-4-7.2C13.7 6.4 12.4 4.4 12 2Z"/></svg>
      </div>
    <% end %>
    <% promo = business.active_promotions.first %>
    <% if promo %>
      <span class="badge-pink absolute left-3 top-3 shadow-sm"><%= t("search.promo") %> <%= promo.discount_percent ? "-#{promo.discount_percent}%" : "" %></span>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="truncate font-bold text-ink-900 group-hover:text-primary-700"><%= business.name %></h3>
      <span class="flex shrink-0 items-center gap-1 text-sm font-bold text-ink-900">
        <svg class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.28 3.95a1 1 0 0 0 .95.69h4.15c.97 0 1.37 1.24.59 1.81l-3.36 2.44a1 1 0 0 0-.36 1.12l1.28 3.95c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 0 0-1.18 0l-3.36 2.44c-.78.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 0 0-.36-1.12L2.08 9.38c-.78-.57-.38-1.81.6-1.81h4.14a1 1 0 0 0 .95-.69l1.28-3.95Z"/></svg>
        <%= business.rating_label %>
        <% if business.reviews_count > 0 %>
          <span class="font-medium text-ink-500">(<%= business.reviews_count %>)</span>
        <% end %>
      </span>
    </div>
    <p class="mt-1 flex items-center gap-1 text-sm text-ink-500">
      <svg class="h-4 w-4 shrink-0 text-ink-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
      <span class="truncate"><%= business.address %>, <%= business.city.name %></span>
    </p>
    <div class="mt-3 flex items-center justify-between">
      <span class="text-xs font-medium text-ink-500"><%= business.service_categories_list %></span>
      <% if business.price_from.positive? %>
        <span class="text-sm font-bold text-primary-600"><%= format_idr(business.price_from) %><span class="text-xs font-medium text-ink-500">+</span></span>
      <% end %>
    </div>
  <span class="mt-3 hidden group-hover:inline-flex btn-primary btn-sm w-full"><%= t("search.view_schedule") %></span>
  </div>
<% end %>
