<% content_for :title, t("search.title") %>

<div class="mx-auto max-w-7xl px-4 py-6 lg:px-8">
  <!-- Search bar -->
  <%= form_with url: search_path, method: :get, class: "rounded-2xl border border-gray-100 bg-white p-2 shadow-sm" do |f| %>
    <div class="grid gap-2 sm:grid-cols-[1fr_1fr_auto]">
      <%= f.text_field :q, placeholder: t("search.search_placeholder"), class: "input border-0 bg-transparent shadow-none", value: params[:q] %>
      <%= f.select :city, City.order(:name).pluck(:name, :slug), { include_blank: t("search.all_cities"), selected: params[:city] }, class: "input border-0 bg-transparent shadow-none" %>
      <%= f.submit t("search.search"), class: "btn-primary btn-md px-8" %>
    </div>
  <% end %>

  <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-ink-500"><strong class="text-ink-900"><%= t("search.found", count: @total_count) %></strong><%= " #{t('search.for_query', query: params[:q])}" if params[:q].present? %><%= " #{t('search.in_city', city: @active_city.name)}" if @active_city %></p>
    <% sort = @sort %>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("search.sort_rating"), search_path(request.query_parameters.merge(sort: "rating")), class: "chip #{sort == 'rating' ? 'chip-active' : ''}" %>
      <%= link_to t("search.sort_price"), search_path(request.query_parameters.merge(sort: "price")), class: "chip #{sort == 'price' ? 'chip-active' : ''}" %>
      <%= form_with url: nearby_search_path, method: :post, local: true, class: "flex items-center gap-2", data: { controller: "nearby-search" } do %>
        <% %i[q city min_price max_price min_rating open_today promo].each do |key| %>
          <%= hidden_field_tag key, params[key] if params[key].present? %>
        <% end %>
        <% Array(params[:categories]).each do |category_slug| %>
          <%= hidden_field_tag "categories[]", category_slug %>
        <% end %>
        <%= hidden_field_tag :latitude, nil, data: { nearby_search_target: "latitude" } %>
        <%= hidden_field_tag :longitude, nil, data: { nearby_search_target: "longitude" } %>
        <button type="button" data-action="click->nearby-search#locate" data-nearby-search-target="button" class="chip #{'chip-active' if sort == 'nearby' && @nearby_active}"><%= t("search.sort_nearest") %></button>
        <span class="sr-only" aria-live="polite" data-nearby-search-target="status"></span>
      <% end %>
    </div>
  </div>
  <% if sort == "nearby" && !@nearby_active %>
    <p class="mt-2 text-xs text-ink-500" role="status"><%= t("search.nearby_permission") %></p>
  <% elsif @nearby_active %>
    <p class="mt-2 text-xs text-ink-500" role="status"><%= t("search.nearby_active") %></p>
  <% end %>

  <div class="mt-4 grid gap-6 lg:grid-cols-[260px_1fr]">
    <!-- Filters sidebar (desktop) -->
    <aside class="hidden lg:block">
      <%= render "searches/filters" %>
    </aside>

    <!-- Mobile filters -->
    <details class="card overflow-hidden lg:hidden">
      <summary class="cursor-pointer list-none px-4 py-3 font-bold">
        <span class="flex items-center justify-between"><%= t("search.filters") %> <span class="text-primary-600 text-sm font-semibold"><%= t("search.show") %></span></span>
      </summary>
      <div class="border-t border-gray-100 p-4">
        <%= render "searches/filters" %>
      </div>
    </details>

    <!-- Results -->
    <div class="space-y-4">
      <% if @businesses.any? %>
        <% @businesses.each do |business| %>
          <div class="card card-hover grid grid-cols-[110px_1fr] overflow-hidden sm:grid-cols-[220px_1fr]">
            <%= link_to business_detail_path(business.slug), class: "relative block bg-primary-50" do %>
              <% if business.cover_image.attached? %>
                <%= image_tag business.cover_image, class: "h-full w-full object-cover", loading: "lazy", alt: business.name %>
              <% else %>
                <div class="flex h-full min-h-[110px] w-full items-center justify-center text-primary-300">
                  <svg class="h-10 w-10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 3.2-1.8 5.4-3.6 7C6 10.9 4.5 13 4.5 15.5A7.5 7.5 0 0 0 12 23a7.5 7.5 0 0 0 7.5-7.5c0-3.4-2.3-5.4-4-7.2C13.7 6.4 12.4 4.4 12 2Z"/></svg>
                </div>
              <% end %>
            <% end %>
            <div class="flex flex-col p-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <%= link_to business_detail_path(business.slug), class: "truncate font-bold text-ink-900 hover:text-primary-700" do %>
                    <%= business.name %>
                  <% end %>
                  <p class="mt-0.5 flex items-center gap-1.5 text-sm">
                    <span class="flex items-center gap-1 font-bold">
                      <svg class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.28 3.95a1 1 0 0 0 .95.69h4.15c.97 0 1.37 1.24.59 1.81l-3.36 2.44a1 1 0 0 0-.36 1.12l1.28 3.95c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 0 0-1.18 0l-3.36 2.44c-.78.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 0 0-.36-1.12L2.08 9.38c-.78-.57-.38-1.81.6-1.81h4.14a1 1 0 0 0 .95-.69l1.28-3.95Z"/></svg>
                      <%= business.rating_label %>
                    </span>
                    <% if business.reviews_count > 0 %>
                      <span class="text-ink-500">(<%= t("search.reviews", count: business.reviews_count) %>)</span>
                    <% end %>
                  </p>
                  <p class="mt-1 flex items-center gap-1 text-sm text-ink-500">
                    <svg class="h-4 w-4 shrink-0 text-ink-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
                    <span class="truncate"><%= business.address %>, <%= business.city.name %></span>
                  </p>
                  <p class="mt-1.5 text-xs font-medium text-ink-500"><%= business.service_categories_list %></p>
                </div>
                <% if business.active_promotions.any? %>
                  <span class="badge-pink shrink-0"><%= t("search.promo") %></span>
                <% end %>
              </div>
              <div class="mt-3 flex items-end justify-between gap-3 sm:mt-auto">
                <div>
                  <% if business.price_from.positive? %>
                    <span class="text-xs text-ink-500"><%= t("search.from") %></span>
                    <p class="font-bold text-primary-600"><%= format_idr(business.price_from) %></p>
                  <% end %>
                </div>
                <%= link_to t("search.view_schedule"), business_book_path(business.slug), class: "btn-primary btn-sm shrink-0" %>
              </div>
            </div>
          </div>
        <% end %>

        <% if @total_pages > 1 %>
          <div class="flex items-center justify-center gap-2 pt-4">
            <% if @page > 1 %>
              <%= link_to t("search.previous"), search_path(request.query_parameters.merge(page: @page - 1)), class: "btn-secondary btn-sm" %>
            <% end %>
            <span class="text-sm text-ink-500"><%= t("search.page", page: @page, pages: @total_pages) %></span>
            <% if @page < @total_pages %>
              <%= link_to t("search.next"), search_path(request.query_parameters.merge(page: @page + 1)), class: "btn-secondary btn-sm" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="card flex flex-col items-center px-6 py-16 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-50 text-3xl">🔍</span>
          <h3 class="mt-4 text-lg font-bold"><%= t("search.no_results") %></h3>
          <p class="mt-1 max-w-sm text-sm text-ink-500"><%= t("search.try_again") %></p>
          <%= link_to t("search.reset_filters"), search_path, class: "btn-secondary btn-md mt-5" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
