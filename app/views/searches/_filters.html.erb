<%= form_with url: search_path, method: :get, local: true, data: { controller: "autosubmit" } do |f| %>
  <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
  <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
  <%= hidden_field_tag :city, params[:city] if params[:city].present? %>
  <div class="card sticky top-20 p-5">
    <h3 class="font-bold"><%= t("search.filter.heading") %></h3>

    <div class="mt-4">
      <p class="label"><%= t("search.filter.city") %></p>
      <%= f.select :city, City.order(:name).pluck(:name, :slug), { include_blank: t("search.all_cities"), selected: params[:city] }, class: "input", data: { action: "change->autosubmit#submit" } %>
    </div>

    <div class="mt-5">
      <p class="label"><%= t("search.filter.category") %></p>
      <div class="space-y-2">
        <% Category.ordered.each do |c| %>
          <label class="flex cursor-pointer items-center gap-2.5 text-sm">
            <%= check_box_tag "categories[]", c.slug, Array(params[:categories]).include?(c.slug), class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500", data: { action: "change->autosubmit#submit" } %>
            <span class="text-ink-700"><%= c.name %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="mt-5">
      <p class="label"><%= t("search.filter.price_range") %></p>
      <div class="flex items-center gap-2">
        <%= f.number_field :min_price, placeholder: t("search.filter.min_price"), value: params[:min_price], min: 0, step: 10000, class: "input", data: { action: "change->autosubmit#submit" } %>
        <span class="text-ink-300">—</span>
        <%= f.number_field :max_price, placeholder: t("search.filter.max_price"), value: params[:max_price], min: 0, step: 10000, class: "input", data: { action: "change->autosubmit#submit" } %>
      </div>
    </div>

    <div class="mt-5">
      <p class="label"><%= t("search.filter.min_rating") %></p>
      <div class="space-y-2">
        <% [["4.5", "★ 4.5+"], ["4.0", "★ 4.0+"], ["3.5", "★ 3.5+"]].each do |value, label| %>
          <label class="flex cursor-pointer items-center gap-2.5 text-sm">
            <%= radio_button_tag "min_rating", value, params[:min_rating] == value, class: "h-4 w-4 border-gray-300 text-primary-600 focus:ring-primary-500", data: { action: "change->autosubmit#submit" } %>
            <span class="text-ink-700"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="mt-5 space-y-3">
      <label class="flex cursor-pointer items-center justify-between text-sm font-medium">
        <span><%= t("search.filter.open_today") %></span>
        <%= check_box_tag "open_today", "1", params[:open_today] == "1", class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500", data: { action: "change->autosubmit#submit" } %>
      </label>
      <label class="flex cursor-pointer items-center justify-between text-sm font-medium">
        <span><%= t("search.filter.promo_only") %></span>
        <%= check_box_tag "promo", "1", params[:promo] == "1", class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500", data: { action: "change->autosubmit#submit" } %>
      </label>
    </div>

    <div class="mt-6 flex gap-2">
      <%= f.submit t("search.filter.apply"), class: "btn-primary btn-md w-full" %>
      <%= link_to t("search.filter.reset"), search_path, class: "btn-secondary btn-md" %>
    </div>
  </div>
<% end %>
