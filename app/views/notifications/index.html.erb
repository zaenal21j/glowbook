<div class="mx-auto max-w-4xl px-4 py-8 lg:px-8">
  <%= render "shared/table_controls", key: "user_notifications" %>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-primary-600"><%= t("notifications.account") %></p>
      <h1 class="mt-1 text-3xl font-extrabold text-ink-900"><%= t("notifications.title") %></h1>
      <p class="mt-2 text-sm text-ink-500"><%= t("notifications.unread_count", count: @unread_count) %></p>
    </div>

    <% if @unread_count.positive? %>
      <%= button_to t("notifications.mark_all_read"), mark_all_notifications_read_path, method: :patch, class: "btn-secondary btn-sm" %>
    <% end %>
  </div>

  <div class="space-y-3">
    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <article class="flex flex-wrap items-start justify-between gap-4 rounded-2xl border p-5 <%= notification.unread? ? 'border-primary-200 bg-primary-50/40' : 'border-gray-100 bg-white' %>">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-bold text-ink-900"><%= notification.title %></h2>
              <% if notification.unread? %>
                <span class="rounded-full bg-primary-100 px-2.5 py-1 text-xs font-semibold text-primary-700"><%= t("notifications.new") %></span>
              <% end %>
            </div>
            <p class="mt-2 text-sm leading-6 text-ink-700"><%= notification.body %></p>
            <time class="mt-2 block text-xs text-ink-500" datetime="<%= notification.created_at.iso8601 %>"><%= notification.created_at.strftime("%d-%m-%Y %H:%M") %></time>
          </div>

          <% if notification.booking_reference.present? %>
            <%= button_to t("notifications.open_booking"), read_notification_path(notification), method: :patch, class: "btn-secondary btn-sm shrink-0" %>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
        <h2 class="font-bold text-ink-900"><%= t("notifications.empty") %></h2>
        <p class="mt-2 text-sm text-ink-500"><%= t("notifications.empty_help") %></p>
      </div>
    <% end %>
  </div>

  <%= render "shared/table_pagination", key: "user_notifications" %>
</div>
