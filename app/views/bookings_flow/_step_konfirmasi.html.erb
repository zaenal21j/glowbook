<h2 class="text-lg font-extrabold"><%= t("booking.confirm_booking") %></h2>

<div class="card mt-4 overflow-hidden">
  <div class="flex items-center gap-3 border-b border-gray-100 p-4">
    <div class="h-12 w-12 overflow-hidden rounded-xl bg-primary-50">
      <img src="https://picsum.photos/seed/<%= @business.slug %>/120/120" alt="" class="h-full w-full object-cover" loading="lazy" />
    </div>
    <div>
      <p class="font-bold"><%= @business.name %></p>
      <p class="text-xs text-ink-500"><%= @business.address %>, <%= @business.city.name %></p>
    </div>
  </div>

  <dl class="divide-y divide-gray-50 p-4 text-sm">
    <div class="flex justify-between py-2">
      <dt class="text-ink-500"><%= t("booking.service") %></dt>
      <dd class="text-right font-medium"><%= @services.pluck(:name).join(", ") %></dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="text-ink-500"><%= t("booking.staff") %></dt>
      <dd class="font-medium"><%= @staff&.name || t("booking.available_staff") %></dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="text-ink-500"><%= t("booking.date") %></dt>
      <dd class="font-medium"><%= l(@date, format: "%A, %d %B %Y") %></dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="text-ink-500"><%= t("booking.time") %></dt>
      <dd class="font-medium"><%= @time.strftime("%H:%M") %> WIB</dd>
    </div>
    <div class="flex justify-between py-2">
      <dt class="text-ink-500"><%= t("booking.duration") %></dt>
      <dd class="font-medium"><%= format_duration(@total_duration) %></dd>
    </div>
    <div class="flex justify-between py-3">
      <dt class="font-bold"><%= t("booking.total_price") %></dt>
      <dd class="font-extrabold text-primary-600"><%= format_idr(@total) %></dd>
    </div>
  </dl>

  <%= form_with url: business_book_complete_path(@business.slug), method: :post, class: "border-t border-gray-100 p-4" do |f| %>
    <p class="font-bold"><%= t("booking.payment_method") %></p>
    <div class="mt-3 space-y-2">
      <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-primary-500 bg-primary-50/50 p-3.5 has-[:checked]:border-primary-500">
        <%= f.radio_button :payment_method, "pay_at_venue", checked: true, class: "h-4 w-4 border-gray-300 text-primary-600" %>
        <div class="flex-1">
          <p class="text-sm font-bold"><%= t("booking.pay_at_venue") %></p>
          <p class="text-xs text-ink-500"><%= t("booking.pay_at_venue_description") %></p>
        </div>
      </label>
      <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 p-3.5 <%= 'opacity-50' unless DuitkuClient.enabled? %>">
        <%= f.radio_button :payment_method, "online_transfer", class: "h-4 w-4 border-gray-300 text-primary-600", disabled: !DuitkuClient.enabled? || @total <= 0 %>
        <div class="flex-1">
          <p class="text-sm font-bold"><%= t("booking.online_payment") %></p>
          <p class="text-xs text-ink-500"><%= @total <= 0 ? t("booking.total_must_be_positive") : DuitkuClient.enabled? ? DuitkuClient.checkout_label : t("booking.payment_not_configured") %></p>
        </div>
      </label>
    </div>
    <%= f.submit t("booking.confirm_booking"), class: "btn-primary btn-lg mt-5 w-full" %>
  <% end %>
</div>
