<% content_for :title, t("booking.title", business: @business.name) %>

<div class="mx-auto max-w-3xl px-4 py-8 lg:px-8">
  <!-- Business mini header -->
  <div class="flex items-center gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-900 text-lg font-extrabold text-white"><%= @business.name[0] %></div>
    <div>
      <p class="font-bold"><%= @business.name %></p>
      <p class="text-xs text-ink-500"><%= @business.address %>, <%= @business.city.name %></p>
    </div>
  </div>

  <!-- Step indicator -->
  <ol class="mt-8 flex items-center justify-between">
    <% step_icons = { "layanan" => "M9.5 3.7 4 6.1v5.4c0 3.6 2.4 6.9 5.5 8.8 3.1-1.9 5.5-5.2 5.5-8.8V6.1l-5.5-2.4Z", "staff" => "M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.1a7.5 7.5 0 0 1 15 0", "tanggal" => "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5A2.25 2.25 0 0 1 5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25M3 18.75A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75M3 12h18", "waktu" => "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", "konfirmasi" => "m4.5 12.75 6 6 9-13.5" } %>
    <% step_labels = { "layanan" => t("booking.steps.services"), "staff" => t("booking.steps.staff"), "tanggal" => t("booking.steps.date"), "waktu" => t("booking.steps.time"), "konfirmasi" => t("booking.steps.confirmation") } %>
    <% current_idx = BookingsFlowController::STEPS.index(@step) %>
    <% BookingsFlowController::STEPS.each_with_index do |s, i| %>
      <li class="flex flex-1 flex-col items-center gap-1.5 <%= 'pointer-events-none' if s != @step %>">
        <% if s == "konfirmasi" %>
          <span class="step-dot <%= 'step-dot-done' if i < current_idx %> <%= 'step-dot-active' if i == current_idx %> <%= 'flex h-7 w-7 items-center justify-center rounded-full border-2' if false %>"><%= i + 1 %></span>
        <% else %>
          <%= link_to business_book_step_path(@business.slug, s), class: "step-dot #{'step-dot-done' if i < current_idx} #{'step-dot-active' if i == current_idx}" do %><%= i + 1 %><% end %>
        <% end %>
        <span class="text-[11px] font-semibold <%= i <= current_idx ? 'text-ink-900' : 'text-ink-500' %>"><%= step_labels[s] %></span>
        <svg class="hidden"><path d="<%= step_icons[s] %>"/></svg>
      </li>
    <% end %>
  </ol>
  <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-gray-100">
    <div class="h-full rounded-full bg-primary-600 transition-all" style="width: <%= ((current_idx + 1).to_f / 5 * 100).to_i %>%"></div>
  </div>

  <!-- Step content -->
  <div class="mt-8">
    <%= render "bookings_flow/step_#{@step}" %>
  </div>
</div>
