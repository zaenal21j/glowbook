<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for(:title) || "Akun Saya — GlowBook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-dvh bg-white">
    <%= render "shared/navbar" %>
    <main class="mx-auto max-w-7xl px-4 py-8 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[240px_1fr]">
        <aside>
          <div class="card sticky top-20 p-3">
            <div class="flex items-center gap-3 border-b border-gray-100 px-2 pb-3 pt-1">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-600 font-bold text-white"><%= current_user.initial %></span>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold"><%= current_user.full_name %></p>
                <p class="truncate text-xs text-ink-500"><%= current_user.email %></p>
              </div>
            </div>
            <nav class="mt-2 space-y-1">
              <%= link_to account_root_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'dashboard'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/></svg>
                Dashboard
              <% end %>
              <%= link_to account_bookings_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'bookings' && action_name == 'index'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5A2.25 2.25 0 0 1 5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25M3 18.75A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75M3 12h18"/></svg>
                Booking Saya
              <% end %>
              <%= link_to account_chats_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'chats'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3h6m-9.75 9 2.6-3.12A8.25 8.25 0 1 1 12 19.5H6.75Z"/></svg>
                Pesan
              <% end %>
              <%= link_to account_favorites_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'favorites'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
                Favorit
              <% end %>
              <%= link_to account_reviews_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'reviews'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.5a.562.562 0 0 1 1.04 0l2.13 5.11 5.52.44c.49.04.7.66.32.98l-4.21 3.6 1.28 5.38a.562.562 0 0 1-.84.61L12 17.25l-4.72 2.87a.562.562 0 0 1-.84-.61l1.28-5.38-4.21-3.6a.562.562 0 0 1 .32-.98l5.52-.44 2.13-5.11Z"/></svg>
                Ulasan
              <% end %>
              <%= link_to account_profile_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'profiles'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
                Profil
              <% end %>
              <%= link_to account_settings_path, class: "sidebar-link #{'sidebar-link-active' if controller_name == 'settings'}" do %>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                Pengaturan
              <% end %>
            </nav>
          </div>
        </aside>
        <div>
          <% if flash[:notice] %><div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= flash[:notice] %></div><% end %>
          <% if flash[:alert] %><div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= flash[:alert] %></div><% end %>
          <%= yield %>
        </div>
      </div>
    </main>
    <%= render "shared/mobile_nav" %>
  </body>
</html>
