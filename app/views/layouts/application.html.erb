<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("home.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "shared/pwa_head" %>
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-dvh flex flex-col bg-white">
    <%= render "shared/navbar" %>

    <main class="flex-1 pb-20 lg:pb-0">
      <% if flash[:notice] %>
        <div class="mx-auto max-w-7xl px-4 pt-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" data-controller="dismissable">
            <div class="flex items-center justify-between gap-4">
              <span><%= flash[:notice] %></span>
              <button type="button" data-action="dismissable#dismiss" aria-label="<%= t('ui.dismiss') %>" class="text-emerald-600 hover:text-emerald-800">&times;</button>
            </div>
          </div>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mx-auto max-w-7xl px-4 pt-4">
          <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" data-controller="dismissable">
            <div class="flex items-center justify-between gap-4">
              <span><%= flash[:alert] %></span>
              <button type="button" data-action="dismissable#dismiss" aria-label="<%= t('ui.dismiss') %>" class="text-red-500 hover:text-red-700">&times;</button>
            </div>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/mobile_nav" %>
  </body>
</html>
