<% content_for :title, "#{@business.name} — GlowBook" %>

<!-- Cover -->
<div class="relative h-56 overflow-hidden bg-primary-100 sm:h-72 lg:h-96">
  <% if @business.cover_image.attached? %>
    <%= image_tag @business.cover_image, class: "h-full w-full object-cover", alt: @business.name %>
  <% else %>
    <img src="https://picsum.photos/seed/<%= @business.slug %>/1600/700" alt="<%= @business.name %>" class="h-full w-full object-cover" />
  <% end %>
  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent"></div>
</div>

<div class="mx-auto max-w-7xl px-4 lg:px-8">
  <!-- Header card -->
  <div class="card -mt-20 relative z-10 p-5 sm:p-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      <div class="flex items-center gap-4">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-ink-900 text-2xl font-extrabold text-white sm:h-20 sm:w-20">
          <%= @business.name[0] %>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h1 class="truncate text-2xl font-extrabold tracking-tight sm:text-3xl"><%= @business.name %></h1>
            <% if @business.active? %>
              <svg class="h-5 w-5 shrink-0 text-sky-500" viewBox="0 0 24 24" fill="currentColor"><path d="m11.6 21.4-1.9-1.7C4.4 15 1.5 12.3 1.5 9a5 5 0 0 1 5-5c1.7 0 3.4.8 4.5 2.1A6 6 0 0 1 15.5 4a5 5 0 0 1 5 5c0 3.3-2.9 6-8.2 10.7l-1.9 1.7Z" opacity=".45"/><path d="m11.6 21.4-1.9-1.7C4.4 15 1.5 12.3 1.5 9a5 5 0 0 1 5-5c1.7 0 3.4.8 4.5 2.1A6 6 0 0 1 15.5 4a5 5 0 0 1 5 5c0 3.3-2.9 6-8.2 10.7l-1.9 1.7Z"/></svg>
            <% end %>
          </div>
          <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <span class="flex items-center gap-1 font-bold">
              <svg class="h-4 w-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.28 3.95a1 1 0 0 0 .95.69h4.15c.97 0 1.37 1.24.59 1.81l-3.36 2.44a1 1 0 0 0-.36 1.12l1.28 3.95c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 0 0-1.18 0l-3.36 2.44c-.78.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 0 0-.36-1.12L2.08 9.38c-.78-.57-.38-1.81.6-1.81h4.14a1 1 0 0 0 .95-.69l1.28-3.95Z"/></svg>
              <%= @business.rating_label %>
            </span>
            <span class="text-ink-500">(<%= @business.reviews_count %> ulasan)</span>
            <span class="text-ink-300">|</span>
            <span class="text-ink-500"><%= @business.service_categories_list %></span>
          </p>
          <p class="mt-1 flex items-center gap-1 text-sm text-ink-500">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
            <%= @business.address %>, <%= @business.city.name %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:ml-auto">
        <% if user_signed_in? && current_user.favorites.exists?(business: @business) %>
          <%= button_to business_unfavorite_path(@business.slug), method: :delete, form: { class: "inline" }, class: "btn-secondary btn-md gap-1.5 text-primary-600", title: "Hapus dari favorit" do %>
            <svg class="h-5 w-5 fill-primary-600" viewBox="0 0 24 24"><path d="m11.6 21.4-1.9-1.7C4.4 15 1.5 12.3 1.5 9a5 5 0 0 1 5-5c1.7 0 3.4.8 4.5 2.1A6 6 0 0 1 15.5 4a5 5 0 0 1 5 5c0 3.3-2.9 6-8.2 10.7l-1.9 1.7Z"/></svg>
            Tersimpan
          <% end %>
        <% else %>
          <%= button_to business_favorite_path(@business.slug), method: :post, form: { class: "inline" }, class: "btn-secondary btn-md gap-1.5", title: "Simpan ke favorit" do %>
            <svg class="h-5 w-5 text-ink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
            <span class="hidden sm:inline">Favorit</span>
          <% end %>
        <% end %>
        <%= link_to "Pesan Sekarang", business_book_path(@business.slug), class: "btn-primary btn-md" %>
        <% if user_signed_in? && @business.owner_id != current_user.id && !@business.staff.exists?(user_id: current_user.id) %>
          <%= button_to "Chat", business_chat_path(@business.slug), method: :post, class: "btn-secondary btn-md" %>
        <% elsif !user_signed_in? %>
          <%= link_to "Chat", login_path, class: "btn-secondary btn-md" %>
        <% end %>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mt-5 -mb-6 flex gap-1 overflow-x-auto border-b border-gray-100 scrollbar-none">
      <% %w[tentang layanan staff ulasan lokasi].each do |tab| %>
        <%= link_to tab.titleize, business_tab_path(@business.slug, tab), class: "tab #{'tab-active border-b-2 border-primary-600' if @tab == tab}", data: { turbo_frame: "business_tab" } %>
      <% end %>
    </div>
  </div>

  <!-- Content -->
  <div class="grid gap-8 py-8 lg:grid-cols-[1fr_340px]">
    <div>
      <%= turbo_frame_tag "business_tab" do %>
        <%= render "businesses/tab_content", business: @business %>
      <% end %>
    </div>
    <aside class="space-y-5">
      <!-- Opening hours -->
      <div class="card p-5">
        <h3 class="flex items-center gap-2 font-bold">
          <svg class="h-5 w-5 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          Jam Buka
          <% if @business.open_now? %>
            <span class="badge-green ml-auto">Buka sekarang</span>
          <% else %>
            <span class="badge-red ml-auto">Tutup</span>
          <% end %>
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          <% (0..6).each do |wday| %>
            <% next unless @business.opening_hour(Date.new(2026, 9, 20 + wday)) || wday <= 6 %>
            <% h = @business.business_hours.find_by(weekday: wday) %>
            <li class="flex items-center justify-between <%= 'font-semibold text-ink-900' if wday == Date.current.wday %> <%= 'text-ink-300' if h.nil? || h.closed? %>">
              <span><%= t("date.day_names")[wday] %></span>
              <span><%= h.nil? || h.closed? ? "Tutup" : "#{h.open_minute / 60}:#{format('%02d', h.open_minute % 60)} - #{h.close_minute / 60}:#{format('%02d', h.close_minute % 60)}" %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Map -->
      <div class="card overflow-hidden">
        <div class="relative h-44 bg-gray-100">
          <iframe class="h-full w-full border-0" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= (@business.longitude.to_f - 0.005) %>%2C<%= (@business.latitude.to_f - 0.004) %>%2C<%= (@business.longitude.to_f + 0.005) %>%2C<%= (@business.latitude.to_f + 0.004) %>&amp;layer=mapnik&amp;marker=<%= @business.latitude %>%2C<%= @business.longitude %>"></iframe>
        </div>
        <div class="p-4">
          <p class="text-sm text-ink-500"><%= @business.address %>, <%= @business.city.name %></p>
          <a href="https://www.openstreetmap.org/?mlat=<%= @business.latitude %>&amp;mlon=<%= @business.longitude %>#map=16/<%= @business.latitude %>/<%= @business.longitude %>" target="_blank" rel="noopener" class="btn-secondary btn-sm mt-3 w-full">Lihat Peta</a>
        </div>
      </div>

      <!-- Promo -->
      <% if @promotions.any? %>
        <div class="card border-primary-100 bg-primary-50/50 p-5">
          <h3 class="font-bold text-primary-700">Promosi</h3>
          <% @promotions.each do |promo| %>
            <div class="mt-3 rounded-xl border border-primary-100 bg-white p-3">
              <p class="text-sm font-bold"><%= promo.title %></p>
              <% if promo.discount_percent %><p class="text-xs font-semibold text-primary-600">Diskon <%= promo.discount_percent %>%</p><% end %>
              <% if promo.code.present? %><p class="mt-1 text-xs text-ink-500">Kode: <span class="font-mono font-bold text-ink-900"><%= promo.code %></span></p><% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </aside>
  </div>
</div>
