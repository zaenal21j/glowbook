<% content_for :title, t("auth.sign_in_title") %>

<div class="mx-auto flex max-w-md flex-col px-4 py-12">
  <div class="text-center">
    <h1 class="text-2xl font-extrabold"><%= t("auth.welcome_back") %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t("auth.sign_in_description") %></p>
  </div>

  <div class="card mt-8 p-6 sm:p-8">
    <%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, t("auth.email"), class: "label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input", placeholder: "nama@email.com" %>
      </div>
      <div>
        <%= f.label :password, t("auth.password"), class: "label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input", placeholder: "••••••••" %>
      </div>
      <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-ink-500">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-gray-300 text-primary-600" %>
          <%= t("auth.remember_me") %>
        </label>
        <%= link_to t("auth.forgot_password"), new_password_path(resource_name), class: "text-sm font-semibold text-primary-600 hover:text-primary-700" %>
      </div>
      <%= f.submit t("auth.sign_in"), class: "btn-primary btn-lg w-full" %>
    <% end %>

    <%= render "devise/shared/oauth_buttons" %>

    <p class="mt-6 text-center text-sm text-ink-500">
      <%= t("auth.no_account") %>
      <%= link_to t("auth.sign_up"), signup_path, class: "font-semibold text-primary-600 hover:text-primary-700" %>
    </p>
  </div>
</div>
