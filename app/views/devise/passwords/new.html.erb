<% content_for :title, "Lupa Kata Sandi — GlowBook" %>

<div class="mx-auto flex max-w-md flex-col px-4 py-12">
  <div class="card p-6 sm:p-8">
    <h1 class="text-xl font-extrabold">Reset kata sandi</h1>
    <p class="mt-2 text-sm text-ink-500">Masukkan email kamu dan kami akan mengirim tautan reset.</p>
    <%= form_with model: resource, as: resource_name, url: password_path(resource_name), class: "mt-6 space-y-4" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div>
        <%= f.label :email, "Email", class: "label" %>
        <%= f.email_field :email, autofocus: true, class: "input" %>
      </div>
      <%= f.submit "Kirim Tautan Reset", class: "btn-primary btn-lg w-full" %>
    <% end %>
    <p class="mt-6 text-center text-sm text-ink-500">
      <%= link_to "← Kembali ke masuk", login_path, class: "font-semibold text-primary-600" %>
    </p>
  </div>
</div>
