<% content_for :title, t("auth.forgot_title") %>

<div class="mx-auto flex max-w-md flex-col px-4 py-12">
  <div class="card p-6 sm:p-8">
    <h1 class="text-xl font-extrabold"><%= t("auth.reset_password") %></h1>
    <p class="mt-2 text-sm text-ink-500"><%= t("auth.reset_description") %></p>
    <%= form_with model: resource, as: resource_name, url: password_path(resource_name), class: "mt-6 space-y-4" do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div>
        <%= f.label :email, t("auth.email"), class: "label" %>
        <%= f.email_field :email, autofocus: true, class: "input" %>
      </div>
      <%= f.submit t("auth.send_reset_link"), class: "btn-primary btn-lg w-full" %>
    <% end %>
    <p class="mt-6 text-center text-sm text-ink-500">
      <%= link_to t("auth.back_to_sign_in"), login_path, class: "font-semibold text-primary-600" %>
    </p>
  </div>
</div>
