# Copy this file to .env.production and replace every placeholder.
APP_HOST=https://glowbook.example.id
GLOWBOOK_PORT=3001
GLOWBOOK_DATABASE_PASSWORD=replace-with-a-long-random-password
SECRET_KEY_BASE=replace-with-output-from-bin-rails-secret
RAILS_MASTER_KEY=
MAILER_FROM=notifikasi@example.id
SMTP_ADDRESS=smtp.example.id
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional fallback; Google/Facebook/SMTP can also be configured in Admin > Integrasi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
JOB_CONCURRENCY=1
