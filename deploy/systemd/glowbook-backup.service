[Unit]
Description=GlowBook database and upload backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/glowbook
UMask=0077
ExecStart=/bin/bash /opt/glowbook/script/backup.sh /opt/glowbook/.env.production /var/backups/glowbook
TimeoutStartSec=30min
TimeoutStopSec=180
